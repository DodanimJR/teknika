---
/**
 * ShopIllustration.astro
 * Ilustracion SVG animada de un pequeno edificio/tienda PYME.
 * Diseñada para contrastar sobre fondos oscuros (hero gradient).
 * Usa colores claros para la estructura y accent para detalles.
 */
---

<svg viewBox="0 0 420 420" fill="none" xmlns="http://www.w3.org/2000/svg" class="t-shop-illustration" aria-hidden="true">

  <!-- ===== SOMBRA DEL EDIFICIO (suave) ===== -->
  <ellipse cx="210" cy="355" rx="150" ry="12" fill="rgba(0,0,0,0.2)"/>

  <!-- ===== EDIFICIO PRINCIPAL ===== -->
  <!-- Fachada (clara para contrastar con fondo oscuro) -->
  <rect x="100" y="130" width="220" height="220" rx="6" fill="var(--t-bg)" opacity="0.95"/>
  <!-- Sombra lateral del edificio -->
  <rect x="300" y="138" width="20" height="212" rx="0" fill="rgba(0,0,0,0.08)"/>

  <!-- ===== TECHO ===== -->
  <path d="M80 132 L210 55 L340 132 Z" fill="var(--t-primary)" opacity="0.95"/>
  <!-- Linea del techo -->
  <path d="M80 132 L210 55 L340 132" fill="none" stroke="var(--t-white)" stroke-width="1.5" opacity="0.3"/>
  <!-- Detalle decorativo del techo -->
  <path d="M130 110 L210 68 L290 110" fill="none" stroke="var(--t-white)" stroke-width="1" opacity="0.2"/>

  <!-- ===== CHIMENEA ===== -->
  <rect x="270" y="68" width="18" height="45" rx="2" fill="var(--t-border)"/>
  <rect x="266" y="64" width="26" height="7" rx="2" fill="var(--t-primary)" opacity="0.8"/>

  <!-- Humo animado -->
  <circle cx="279" cy="52" r="4" fill="var(--t-white)" opacity="0.5">
    <animate attributeName="cy" values="52;30;10" dur="4s" repeatCount="indefinite"/>
    <animate attributeName="opacity" values="0.5;0.25;0" dur="4s" repeatCount="indefinite"/>
    <animate attributeName="r" values="4;7;10" dur="4s" repeatCount="indefinite"/>
  </circle>
  <circle cx="283" cy="46" r="3" fill="var(--t-white)" opacity="0.35">
    <animate attributeName="cy" values="46;22;0" dur="5s" repeatCount="indefinite"/>
    <animate attributeName="opacity" values="0.35;0.15;0" dur="5s" repeatCount="indefinite"/>
    <animate attributeName="r" values="3;6;9" dur="5s" repeatCount="indefinite"/>
  </circle>

  <!-- ===== TOLDO / AWNING ===== -->
  <path d="M85 132 L335 132 L342 158 L78 158 Z" fill="var(--t-accent)" opacity="0.9"/>
  <!-- Rayas del toldo -->
  <path d="M120 132 L113 158" stroke="var(--t-white)" stroke-width="1.5" opacity="0.35"/>
  <path d="M160 132 L153 158" stroke="var(--t-white)" stroke-width="1.5" opacity="0.35"/>
  <path d="M200 132 L193 158" stroke="var(--t-white)" stroke-width="1.5" opacity="0.35"/>
  <path d="M240 132 L233 158" stroke="var(--t-white)" stroke-width="1.5" opacity="0.35"/>
  <path d="M280 132 L273 158" stroke="var(--t-white)" stroke-width="1.5" opacity="0.35"/>
  <path d="M320 132 L313 158" stroke="var(--t-white)" stroke-width="1.5" opacity="0.35"/>
  <!-- Borde ondulado del toldo -->
  <path d="M78 158 Q93 170 110 158 Q127 146 145 158 Q162 170 180 158 Q197 146 215 158 Q232 170 250 158 Q267 146 285 158 Q302 170 320 158 Q337 146 342 158" stroke="var(--t-accent)" stroke-width="2.5" fill="none" opacity="0.7"/>

  <!-- ===== LETRERO ===== -->
  <rect x="150" y="168" width="120" height="28" rx="5" fill="var(--t-primary)" opacity="0.9"/>
  <!-- Texto del letrero -->
  <rect x="165" y="179" width="28" height="5" rx="2.5" fill="var(--t-white)" opacity="0.9"/>
  <rect x="198" y="179" width="56" height="5" rx="2.5" fill="var(--t-white)" opacity="0.65"/>

  <!-- ===== VENTANA IZQUIERDA ===== -->
  <rect x="118" y="206" width="72" height="58" rx="5" fill="var(--t-primary)" opacity="0.15"/>
  <rect x="118" y="206" width="72" height="58" rx="5" fill="none" stroke="var(--t-border)" stroke-width="2"/>
  <!-- Divisiones de la ventana -->
  <line x1="154" y1="208" x2="154" y2="262" stroke="var(--t-border)" stroke-width="1.5"/>
  <line x1="120" y1="235" x2="188" y2="235" stroke="var(--t-border)" stroke-width="1.5"/>
  <!-- Brillo de la ventana -->
  <rect x="122" y="210" width="14" height="22" rx="2" fill="var(--t-accent)" opacity="0.12"/>
  <!-- Luz calida interior animada -->
  <rect x="157" y="238" width="28" height="20" rx="2" fill="var(--t-accent)" opacity="0.15">
    <animate attributeName="opacity" values="0.15;0.3;0.15" dur="5s" repeatCount="indefinite"/>
  </rect>

  <!-- ===== VENTANA DERECHA ===== -->
  <rect x="230" y="206" width="72" height="58" rx="5" fill="var(--t-primary)" opacity="0.15"/>
  <rect x="230" y="206" width="72" height="58" rx="5" fill="none" stroke="var(--t-border)" stroke-width="2"/>
  <!-- Divisiones de la ventana -->
  <line x1="266" y1="208" x2="266" y2="262" stroke="var(--t-border)" stroke-width="1.5"/>
  <line x1="232" y1="235" x2="300" y2="235" stroke="var(--t-border)" stroke-width="1.5"/>
  <!-- Brillo de la ventana -->
  <rect x="234" y="210" width="14" height="22" rx="2" fill="var(--t-accent)" opacity="0.12"/>
  <!-- Luz calida interior animada -->
  <rect x="234" y="238" width="28" height="20" rx="2" fill="var(--t-accent)" opacity="0.1">
    <animate attributeName="opacity" values="0.1;0.25;0.1" dur="6s" repeatCount="indefinite"/>
  </rect>

  <!-- ===== PUERTA ===== -->
  <rect x="183" y="278" width="54" height="72" rx="5" fill="var(--t-primary)" opacity="0.25"/>
  <rect x="183" y="278" width="54" height="72" rx="5" fill="none" stroke="var(--t-border)" stroke-width="2"/>
  <!-- Vidrio de la puerta -->
  <rect x="190" y="286" width="40" height="35" rx="3" fill="var(--t-primary)" opacity="0.1"/>
  <rect x="190" y="286" width="40" height="35" rx="3" fill="none" stroke="var(--t-border)" stroke-width="1" opacity="0.5"/>
  <!-- Manija de la puerta -->
  <circle cx="227" cy="318" r="3.5" fill="var(--t-accent)" opacity="0.9"/>
  <!-- Arco decorativo sobre la puerta -->
  <path d="M183 283 Q210 268 237 283" stroke="var(--t-accent)" stroke-width="2" fill="none" opacity="0.5"/>

  <!-- ===== CARTEL "ABIERTO" (pulsante) ===== -->
  <rect x="195" y="292" width="30" height="12" rx="3" fill="var(--t-accent)" opacity="0.85">
    <animate attributeName="opacity" values="0.85;0.5;0.85" dur="2.5s" repeatCount="indefinite"/>
  </rect>
  <rect x="200" y="296" width="20" height="4" rx="2" fill="var(--t-white)" opacity="0.95"/>

  <!-- ===== ACERA / SUELO ===== -->
  <rect x="70" y="348" width="280" height="6" rx="3" fill="var(--t-white)" opacity="0.15"/>

  <!-- ===== PLANTA IZQUIERDA ===== -->
  <g transform="translate(65, 305)">
    <!-- Maceta -->
    <path d="M2 18 L7 40 L27 40 L32 18 Z" fill="var(--t-border)" opacity="0.7"/>
    <rect x="0" y="14" width="34" height="6" rx="3" fill="var(--t-accent)" opacity="0.6"/>
    <!-- Follaje -->
    <ellipse cx="17" cy="6" rx="16" ry="14" fill="var(--t-accent)" opacity="0.6"/>
    <ellipse cx="11" cy="0" rx="10" ry="10" fill="var(--t-accent)" opacity="0.45"/>
    <ellipse cx="23" cy="1" rx="11" ry="10" fill="var(--t-accent)" opacity="0.5"/>
  </g>

  <!-- ===== PLANTA DERECHA ===== -->
  <g transform="translate(325, 308)">
    <!-- Maceta -->
    <path d="M2 16 L6 35 L24 35 L28 16 Z" fill="var(--t-border)" opacity="0.7"/>
    <rect x="0" y="12" width="30" height="6" rx="3" fill="var(--t-accent)" opacity="0.6"/>
    <!-- Follaje -->
    <ellipse cx="15" cy="5" rx="14" ry="12" fill="var(--t-accent)" opacity="0.55"/>
    <ellipse cx="9" cy="-1" rx="9" ry="9" fill="var(--t-accent)" opacity="0.4"/>
    <ellipse cx="21" cy="0" rx="9" ry="9" fill="var(--t-accent)" opacity="0.45"/>
  </g>

  <!-- ===== ICONO WIFI (flotante, arriba derecha) ===== -->
  <g transform="translate(350, 90)" opacity="0.65">
    <path d="M8 18 A6 6 0 0 1 22 18" stroke="var(--t-white)" stroke-width="2.5" fill="none" stroke-linecap="round"/>
    <path d="M4 13 A12 12 0 0 1 26 13" stroke="var(--t-white)" stroke-width="2.5" fill="none" stroke-linecap="round"/>
    <path d="M0 8 A18 18 0 0 1 30 8" stroke="var(--t-white)" stroke-width="2.5" fill="none" stroke-linecap="round"/>
    <circle cx="15" cy="21" r="2.5" fill="var(--t-white)"/>
    <animateTransform attributeName="transform" type="translate" values="350,90;350,83;350,90" dur="3s" repeatCount="indefinite"/>
  </g>

  <!-- ===== ICONO UBICACION (flotante, arriba izquierda) ===== -->
  <g transform="translate(35, 65)" opacity="0.6">
    <path d="M15 2 C8 2 2 7.5 2 14 C2 22 15 32 15 32 C15 32 28 22 28 14 C28 7.5 22 2 15 2 Z" stroke="var(--t-white)" stroke-width="2.5" fill="none"/>
    <circle cx="15" cy="14" r="4.5" fill="var(--t-white)" opacity="0.7"/>
    <animateTransform attributeName="transform" type="translate" values="35,65;35,58;35,65" dur="4s" repeatCount="indefinite"/>
  </g>

  <!-- ===== ICONO ESTRELLA (flotante, derecha) ===== -->
  <g transform="translate(365, 220)" opacity="0.55">
    <polygon points="12,2 14.5,8.5 22,9 16.5,14 18,21 12,17.5 6,21 7.5,14 2,9 9.5,8.5" fill="var(--t-white)"/>
    <animateTransform attributeName="transform" type="translate" values="365,220;365,213;365,220" dur="3.5s" repeatCount="indefinite"/>
  </g>

  <!-- ===== ICONO CORAZON (flotante, izquierda) ===== -->
  <g transform="translate(30, 195)" opacity="0.5">
    <path d="M12 21 C12 21 2 14 2 8 C2 5 4.5 2 7.5 2 C9.5 2 11 3.5 12 5 C13 3.5 14.5 2 16.5 2 C19.5 2 22 5 22 8 C22 14 12 21 12 21 Z" fill="var(--t-white)"/>
    <animateTransform attributeName="transform" type="translate" values="30,195;30,188;30,195" dur="5s" repeatCount="indefinite"/>
  </g>

  <!-- ===== PUNTOS DECORATIVOS FLOTANTES ===== -->
  <circle cx="385" cy="310" r="3" fill="var(--t-white)" opacity="0.25">
    <animate attributeName="cy" values="310;302;310" dur="3s" repeatCount="indefinite"/>
  </circle>
  <circle cx="395" cy="150" r="2.5" fill="var(--t-white)" opacity="0.2">
    <animate attributeName="cy" values="150;142;150" dur="4s" repeatCount="indefinite"/>
  </circle>
  <circle cx="20" cy="260" r="2" fill="var(--t-white)" opacity="0.3">
    <animate attributeName="cy" values="260;254;260" dur="2.5s" repeatCount="indefinite"/>
  </circle>
  <circle cx="390" cy="270" r="2" fill="var(--t-white)" opacity="0.2">
    <animate attributeName="cy" values="270;263;270" dur="3.5s" repeatCount="indefinite"/>
  </circle>
  <circle cx="25" cy="140" r="1.5" fill="var(--t-white)" opacity="0.25">
    <animate attributeName="cy" values="140;135;140" dur="3s" repeatCount="indefinite"/>
  </circle>

</svg>

<style>
  .t-shop-illustration {
    width: 100%;
    max-width: 460px;
    height: auto;
    filter: drop-shadow(0 10px 30px rgba(0, 0, 0, 0.15));
  }

  @media (max-width: 768px) {
    .t-shop-illustration {
      max-width: 300px;
      margin: 0 auto;
    }
  }
</style>
