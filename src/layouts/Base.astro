---
interface Props {
  title: string;
  description: string;
  canonical?: string;
}

const { title, description, canonical } = Astro.props;
const siteUrl = 'https://teknika.co.cr';
const fullTitle = title === 'Inicio'
  ? 'Teknika CR - Soporte Técnico y Consultoría Informática'
  : `${title} | Teknika CR`;
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <meta name="author" content="Teknika CR" />
    <meta name="theme-color" content="#122C34" />

    <title>{fullTitle}</title>

    {canonical && <link rel="canonical" href={canonical} />}

    <!-- Favicon -->
    <link rel="icon" type="image/png" href="/img/logo-icon.png" />
    <link rel="apple-touch-icon" href="/img/logo-icon.png" />

    <!-- DNS prefetch para servicios externos -->
    <link rel="dns-prefetch" href="https://formspree.io" />
    <link rel="dns-prefetch" href="https://wa.me" />

    <!-- Open Graph -->
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical || siteUrl} />
    <meta property="og:locale" content="es_CR" />
    <meta property="og:site_name" content="Teknika CR" />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />

    <!-- Fuentes (optimizado: preconnect + preload + font-display swap) -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap"
      rel="stylesheet"
      media="print"
      onload="this.media='all'"
    />
    <noscript>
      <link
        href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap"
        rel="stylesheet"
      />
    </noscript>

    <!-- Schema.org LocalBusiness + OfferCatalog -->
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "LocalBusiness",
      "name": "Teknika CR",
      "description": "Soporte técnico de computadoras, asesoría de compra de equipo informático, formateo, instalación de software, asesoría de inteligencia artificial y desarrollo de sitios web para PYMEs en Costa Rica.",
      "url": siteUrl,
      "telephone": "+506-7195-1856",
      "email": "info@teknika.co.cr",
      "image": siteUrl + "/img/logo-square-dark.png",
      "logo": siteUrl + "/img/logo-icon.png",
      "founder": {
        "@type": "Person",
        "name": "Patrick Dodanim Castillo Flores",
        "jobTitle": "Ingeniero en Sistemas"
      },
      "address": {
        "@type": "PostalAddress",
        "addressLocality": "Alajuela",
        "addressRegion": "Alajuela",
        "addressCountry": "CR"
      },
      "geo": {
        "@type": "GeoCoordinates",
        "latitude": 10.0162,
        "longitude": -84.2116
      },
      "areaServed": [
        { "@type": "City", "name": "Alajuela" },
        { "@type": "City", "name": "San José" },
        { "@type": "City", "name": "Heredia" },
        { "@type": "City", "name": "Cartago" },
        { "@type": "Place", "name": "Gran Área Metropolitana, Costa Rica" }
      ],
      "priceRange": "$$",
      "currenciesAccepted": "CRC",
      "paymentAccepted": "SINPE Móvil, Transferencia bancaria, Efectivo",
      "availableLanguage": ["es", "en"],
      "openingHoursSpecification": {
        "@type": "OpeningHoursSpecification",
        "dayOfWeek": ["Monday", "Tuesday", "Wednesday", "Thursday", "Friday"],
        "opens": "09:00",
        "closes": "17:00"
      },
      "sameAs": [
        "https://www.instagram.com/teknikacr/",
        "https://www.facebook.com/profile.php?id=61591716943373",
        "https://www.tiktok.com/@teknikacr"
      ],
      "hasOfferCatalog": {
        "@type": "OfferCatalog",
        "name": "Servicios de Teknika CR",
        "itemListElement": [
          {
            "@type": "OfferCatalog",
            "name": "Diagnóstico y reparación",
            "itemListElement": [
              { "@type": "Offer", "itemOffered": { "@type": "Service", "name": "Diagnóstico básico (software)", "description": "Revisión completa del software, detección de virus, errores y problemas de rendimiento" }, "price": "6000", "priceCurrency": "CRC" },
              { "@type": "Offer", "itemOffered": { "@type": "Service", "name": "Diagnóstico avanzado (hardware)", "description": "Revisión física del equipo, pruebas de componentes, identificación de fallas de hardware" }, "price": "11250", "priceCurrency": "CRC" }
            ]
          },
          {
            "@type": "OfferCatalog",
            "name": "Formateo e instalación",
            "itemListElement": [
              { "@type": "Offer", "itemOffered": { "@type": "Service", "name": "Formateo + Windows + Office", "description": "Formateo limpio, instalación de Windows, drivers y Microsoft Office" }, "price": "11250", "priceCurrency": "CRC" },
              { "@type": "Offer", "itemOffered": { "@type": "Service", "name": "Paquete completo de formateo", "description": "Backup de datos, formateo, Windows, Office, antivirus y limpieza completa" }, "price": "22500", "priceCurrency": "CRC" }
            ]
          },
          {
            "@type": "OfferCatalog",
            "name": "Limpieza y mantenimiento",
            "itemListElement": [
              { "@type": "Offer", "itemOffered": { "@type": "Service", "name": "Limpieza interna + pasta térmica", "description": "Limpieza interna de laptop o desktop con cambio de pasta térmica" }, "price": "9000", "priceCurrency": "CRC" },
              { "@type": "Offer", "itemOffered": { "@type": "Service", "name": "Cambio de HDD a SSD", "description": "Reemplazo de disco duro mecánico por SSD con clonación de datos sin perder archivos" }, "price": "7500", "priceCurrency": "CRC" }
            ]
          },
          {
            "@type": "OfferCatalog",
            "name": "Asesoría de inteligencia artificial",
            "itemListElement": [
              { "@type": "Offer", "itemOffered": { "@type": "Service", "name": "Sesión individual de IA (1 hora)", "description": "Sesión personalizada virtual para aprender a usar ChatGPT, Claude, Gemini y otras herramientas de IA" }, "price": "11250", "priceCurrency": "CRC" },
              { "@type": "Offer", "itemOffered": { "@type": "Service", "name": "Bundle 6 sesiones de IA", "description": "6 horas de tutoría virtual de IA con plan de aprendizaje personalizado y soporte por chat" }, "price": "56250", "priceCurrency": "CRC" },
              { "@type": "Offer", "itemOffered": { "@type": "Service", "name": "Taller PYME de IA", "description": "Taller práctico de 3 horas de inteligencia artificial para equipos de trabajo, sin límite de participantes" }, "price": "37500", "priceCurrency": "CRC" }
            ]
          },
          {
            "@type": "OfferCatalog",
            "name": "Desarrollo web para PYMEs",
            "itemListElement": [
              { "@type": "Offer", "itemOffered": { "@type": "Service", "name": "Landing page profesional", "description": "Sitio web de 1 página con dominio propio, email profesional, hosting gratuito, SEO y optimización para IA" }, "price": "90000", "priceCurrency": "CRC" },
              { "@type": "Offer", "itemOffered": { "@type": "Service", "name": "Sitio web completo", "description": "Sitio web de 3-5 páginas con blog, dominio, email, hosting gratuito, SEO y optimización para IA" }, "price": "187500", "priceCurrency": "CRC" }
            ]
          }
        ]
      }
    })} />

    <!-- Schema.org FAQPage -->
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "FAQPage",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "¿Cuánto cuesta reparar una laptop en Costa Rica?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "En Teknika CR, el diagnóstico básico cuesta ₡6,000 y el avanzado ₡11,250. El formateo completo con backup, Windows, Office y antivirus cuesta ₡22,500. La limpieza interna con cambio de pasta térmica cuesta ₡9,000. Todos los precios incluyen descuento de lanzamiento del 25%. El diagnóstico se descuenta del total si se procede con la reparación."
          }
        },
        {
          "@type": "Question",
          "name": "¿Dónde puedo reparar mi computadora en Alajuela, Costa Rica?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Teknika CR está ubicado en Alajuela Centro y da servicio a todo el Gran Área Metropolitana (GAM) de Costa Rica. Recibimos equipos de lunes a viernes de 9am a 5pm. También ofrecemos soporte remoto a todo el país. WhatsApp: 7195-1856."
          }
        },
        {
          "@type": "Question",
          "name": "¿Cuánto cuesta un sitio web en Costa Rica?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "En Teknika CR, una landing page profesional cuesta desde ₡90,000 y un sitio web completo de 3-5 páginas desde ₡187,500. Incluye dominio propio (.co.cr o .com), email profesional, hosting gratuito con Cloudflare Pages, SEO y optimización para inteligencia artificial. Entrega en 1-2 semanas."
          }
        },
        {
          "@type": "Question",
          "name": "¿Cuánto cuesta cambiar el disco duro a SSD?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "El cambio de HDD a SSD con clonación de datos (sin perder archivos) cuesta ₡7,500 más el costo del SSD. Es la mejor inversión para una laptop lenta: el encendido pasa de 3-5 minutos a 15-25 segundos."
          }
        },
        {
          "@type": "Question",
          "name": "¿Dan clases de inteligencia artificial en Costa Rica?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Sí, Teknika CR ofrece sesiones personalizadas de asesoría de inteligencia artificial desde ₡11,250 por hora. Enseñamos a usar ChatGPT, Claude, Gemini, Copilot y más. Las sesiones son virtuales, personalizadas al trabajo o negocio del cliente, sin jerga técnica. También ofrecemos talleres para equipos de empresas desde ₡37,500."
          }
        },
        {
          "@type": "Question",
          "name": "¿Ofrecen soporte técnico remoto en Costa Rica?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Sí, damos soporte remoto a todo Costa Rica usando TeamViewer o AnyDesk. Ideal para diagnósticos de software, configuraciones, limpieza de virus y asesoría. Nos conectamos por videollamada y resolvemos el problema sin que tengás que salir de tu casa."
          }
        }
      ]
    })} />

    <!-- Estilos -->
    <style is:global>
      @import '../styles/global.css';
    </style>
  </head>
  <body>
    <header class="header">
      <nav class="nav container">
        <a href="/" class="nav__logo">
          <img src="/img/logo-icon.png" alt="Teknika CR" class="nav__logo-img" width="44" height="44" />
          <span class="nav__logo-text">Teknika<span class="nav__logo-cr">CR</span></span>
        </a>
        <span class="nav__lang-badge" title="Service available in English">ES / EN</span>

        <button class="nav__toggle" aria-label="Abrir menú" aria-expanded="false">
          <span></span>
          <span></span>
          <span></span>
        </button>

        <ul class="nav__links" id="nav-links">
          <li><a href="/">Inicio</a></li>
          <li><a href="/servicios">Servicios</a></li>
          <li><a href="/asesoria-ia">Asesoría IA</a></li>
          <li><a href="/ofertas">Ofertas</a></li>
          <li><a href="/sobre">Nosotros</a></li>
          <li><a href="/blog">Blog</a></li>
          <li><a href="/contacto">Contacto</a></li>
          <li>
            <a href="https://wa.me/50671951856?text=Hola%20Teknika%20CR%2C%20necesito%20soporte%20t%C3%A9cnico"
               class="btn btn--accent btn--nav"
               target="_blank"
               rel="noopener">
              WhatsApp
            </a>
          </li>
        </ul>
      </nav>
    </header>

    <div class="launch-banner">
      <div class="container">
        <p class="launch-banner__text">
          <span class="launch-banner__badge">-25%</span>
          <strong>Precio de lanzamiento</strong> en todos los servicios &mdash; <a href="/ofertas">Ver ofertas</a>
        </p>
      </div>
    </div>

    <main>
      <slot />
    </main>

    <footer class="footer">
      <div class="container">
        <div class="footer__grid">
          <div class="footer__brand">
            <a href="/" class="footer__logo">
              <img src="/img/logo-icon.png" alt="Teknika CR" class="footer__logo-img" width="42" height="42" />
              <span class="footer__logo-text">Teknika<span class="footer__logo-cr">CR</span></span>
            </a>
            <p class="footer__tagline">Tecnología que funciona.<br />Soluciones que entendés.</p>
          </div>

          <div class="footer__col">
            <h4>Servicios</h4>
            <ul>
              <li><a href="/servicios#diagnostico">Diagnóstico y reparación</a></li>
              <li><a href="/servicios#formateo">Formateo e instalación</a></li>
              <li><a href="/servicios#asesoria">Asesoría de compra</a></li>
              <li><a href="/asesoria-ia">Asesoría de IA</a></li>
              <li><a href="/servicios#web">Tu negocio en internet</a></li>
              <li><a href="/servicios#paquetes">Paquetes</a></li>
            </ul>
          </div>

          <div class="footer__col">
            <h4>Empresa</h4>
            <ul>
              <li><a href="/sobre">Sobre nosotros</a></li>
              <li><a href="/blog">Blog</a></li>
              <li><a href="/contacto">Contacto</a></li>
            </ul>
          </div>

          <div class="footer__col">
            <h4>Contacto</h4>
            <ul>
              <li><a href="mailto:info@teknika.co.cr">info@teknika.co.cr</a></li>
              <li><a href="https://wa.me/50671951856" target="_blank" rel="noopener">WhatsApp</a></li>
              <li>GAM, Costa Rica</li>
            </ul>
            <div class="footer__social">
              <a href="https://www.instagram.com/teknikacr/" target="_blank" rel="noopener" aria-label="Instagram" class="footer__social-link">
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="2" width="20" height="20" rx="5" ry="5"/><path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"/><line x1="17.5" y1="6.5" x2="17.51" y2="6.5"/></svg>
              </a>
              <a href="https://www.facebook.com/profile.php?id=61591716943373" target="_blank" rel="noopener" aria-label="Facebook" class="footer__social-link">
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M18 2h-3a5 5 0 0 0-5 5v3H7v4h3v8h4v-8h3l1-4h-4V7a1 1 0 0 1 1-1h3z"/></svg>
              </a>
              <a href="https://www.tiktok.com/@teknikacr" target="_blank" rel="noopener" aria-label="TikTok" class="footer__social-link">
                <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor"><path d="M19.59 6.69a4.83 4.83 0 0 1-3.77-4.25V2h-3.45v13.67a2.89 2.89 0 0 1-2.88 2.5 2.89 2.89 0 0 1-2.89-2.89 2.89 2.89 0 0 1 2.89-2.89c.28 0 .54.04.79.1v-3.5a6.37 6.37 0 0 0-.79-.05A6.34 6.34 0 0 0 3.15 15a6.34 6.34 0 0 0 6.34 6.34 6.34 6.34 0 0 0 6.34-6.34V8.72a8.2 8.2 0 0 0 4.76 1.52V6.79a4.84 4.84 0 0 1-1-.1z"/></svg>
              </a>
            </div>
          </div>
        </div>

        <div class="footer__bottom">
          <p>&copy; {new Date().getFullYear()} Teknika CR. Todos los derechos reservados.</p>
        </div>
      </div>
    </footer>

    <script>
      const toggle = document.querySelector('.nav__toggle');
      const links = document.getElementById('nav-links');
      if (toggle && links) {
        toggle.addEventListener('click', () => {
          const isOpen = links.classList.toggle('nav__links--open');
          toggle.setAttribute('aria-expanded', String(isOpen));
        });
      }
    </script>
  </body>
</html>

<style>
  /* ============================================
     Header & Nav
     ============================================ */
  .header {
    position: sticky;
    top: 0;
    z-index: 100;
    background: rgba(255, 255, 255, 0.95);
    backdrop-filter: blur(10px);
    border-bottom: 1px solid var(--color-gray-200);
  }

  .nav {
    display: flex;
    align-items: center;
    justify-content: space-between;
    height: 4rem;
  }

  .nav__logo {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    text-decoration: none;
    color: var(--color-dark);
    font-weight: 800;
    font-size: 1.25rem;
  }

  .nav__logo-img {
    width: 44px;
    height: 44px;
    border-radius: var(--radius-md);
    object-fit: contain;
  }

  .nav__logo-cr {
    color: var(--color-cyan);
  }

  .nav__lang-badge {
    font-size: 0.6875rem;
    font-weight: 600;
    color: var(--color-gray-400);
    border: 1px solid var(--color-gray-200);
    border-radius: var(--radius-sm);
    padding: 2px 6px;
    letter-spacing: 0.5px;
    cursor: default;
  }

  .nav__links {
    display: flex;
    align-items: center;
    gap: var(--space-lg);
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .nav__links a {
    color: var(--color-gray-700);
    font-weight: 500;
    font-size: 0.9375rem;
    transition: color var(--transition);
  }

  .nav__links a:hover {
    color: var(--color-primary);
  }

  .btn--nav {
    padding: 0.5rem 1rem;
    font-size: 0.875rem;
  }

  .nav__toggle {
    display: none;
    flex-direction: column;
    gap: 5px;
    background: none;
    border: none;
    cursor: pointer;
    padding: 4px;
  }

  .nav__toggle span {
    display: block;
    width: 24px;
    height: 2px;
    background-color: var(--color-dark);
    border-radius: 2px;
    transition: all var(--transition);
  }

  /* ============================================
     Footer
     ============================================ */
  .footer {
    background-color: var(--color-dark);
    color: var(--color-gray-300);
    padding: var(--space-3xl) 0 var(--space-xl);
  }

  .footer__grid {
    display: grid;
    grid-template-columns: 2fr 1fr 1fr 1fr;
    gap: var(--space-2xl);
    margin-bottom: var(--space-2xl);
  }

  .footer__logo {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    text-decoration: none;
    font-weight: 800;
    font-size: 1.25rem;
  }

  .footer__logo-img {
    width: 42px;
    height: 42px;
    border-radius: var(--radius-md);
    object-fit: contain;
  }

  .footer__logo-text {
    color: var(--color-white);
  }

  .footer__logo-cr {
    color: var(--color-cyan);
  }

  .footer__tagline {
    margin-top: var(--space-md);
    font-size: 0.9375rem;
    line-height: 1.6;
  }

  .footer__col h4 {
    color: var(--color-white);
    font-size: 0.9375rem;
    font-weight: 600;
    margin-bottom: var(--space-md);
  }

  .footer__col ul {
    list-style: none;
    padding: 0;
  }

  .footer__col li {
    margin-bottom: var(--space-sm);
    font-size: 0.875rem;
  }

  .footer__col a {
    color: var(--color-gray-300);
  }

  .footer__col a:hover {
    color: var(--color-cyan);
  }

  .footer__bottom {
    border-top: 1px solid var(--color-navy);
    padding-top: var(--space-lg);
    text-align: center;
    font-size: 0.8125rem;
    color: var(--color-gray-400);
  }

  .footer__bottom p {
    margin: 0;
  }

  .footer__social {
    display: flex;
    gap: var(--space-md);
    margin-top: var(--space-lg);
  }

  .footer__social-link {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 36px;
    height: 36px;
    border-radius: var(--radius-md);
    background: rgba(255, 255, 255, 0.08);
    color: var(--color-gray-300);
    transition: all var(--transition);
  }

  .footer__social-link:hover {
    background: var(--color-cyan);
    color: var(--color-dark);
    transform: translateY(-2px);
  }

  /* ============================================
     Responsive
     ============================================ */
  @media (max-width: 768px) {
    .nav__toggle {
      display: flex;
    }

    .nav__links {
      display: none;
      position: absolute;
      top: 4rem;
      left: 0;
      right: 0;
      background: var(--color-white);
      flex-direction: column;
      padding: var(--space-lg);
      border-bottom: 1px solid var(--color-gray-200);
      box-shadow: var(--shadow-lg);
    }

    .nav__links--open {
      display: flex;
    }

    .footer__grid {
      grid-template-columns: 1fr 1fr;
      gap: var(--space-xl);
    }
  }

  @media (max-width: 480px) {
    .footer__grid {
      grid-template-columns: 1fr;
    }
  }
</style>
