---
import '@fontsource/inter/400.css';
import '@fontsource/inter/500.css';
import '@fontsource/inter/600.css';
import '@fontsource/inter/700.css';
import '@fontsource/inter/800.css';
import { planesIA, colones } from '../data/precios-ia';
import { paquetesWeb } from '../data/precios-web';

interface Props {
  title: string;
  description: string;
  /** Ignorado: el canonical se calcula de la URL (siempre con / final) */
  canonical?: string;
  /** Migas de pan para schema.org: [{ name, path }] sin incluir Inicio */
  breadcrumbs?: { name: string; path: string }[];
  /** JSON-LD adicional de la página (por ejemplo, Service) */
  schemas?: Record<string, unknown>[];
  noindex?: boolean;
}

const { title, description, breadcrumbs = [], schemas = [], noindex = false } = Astro.props;
const siteUrl = 'https://teknika.co.cr';
const ruta = Astro.url.pathname.endsWith('/') ? Astro.url.pathname : Astro.url.pathname + '/';
const canonical = siteUrl + ruta;
const breadcrumbSchema = breadcrumbs.length
  ? {
      '@context': 'https://schema.org',
      '@type': 'BreadcrumbList',
      itemListElement: [{ name: 'Inicio', path: '/' }, ...breadcrumbs].map((b, i) => ({
        '@type': 'ListItem',
        position: i + 1,
        name: b.name,
        item: siteUrl + b.path,
      })),
    }
  : null;
const fullTitle = title === 'Inicio'
  ? 'Teknika CR - Asesoría, coaching y capacitación en IA en Costa Rica'
  : `${title} | Teknika CR`;

const ofertaIA = (p: (typeof planesIA)[number]) => ({
  '@type': 'Offer',
  itemOffered: { '@type': 'Service', name: p.nombre, description: p.resumen },
  price: String(p.precio),
  priceCurrency: 'CRC',
  valueAddedTaxIncluded: true,
});

const localBusiness = {
  '@context': 'https://schema.org',
  '@type': 'ProfessionalService',
  name: 'Teknika CR',
  description: 'Asesoría, coaching y capacitación en inteligencia artificial para profesionales, PYMEs y organizaciones en Costa Rica. También desarrollo web y soporte técnico.',
  url: siteUrl,
  telephone: '+506-7195-1856',
  email: 'info@teknika.co.cr',
  image: siteUrl + '/img/og-teknika.png',
  logo: siteUrl + '/img/logo-icon-512.png',
  founder: { '@type': 'Person', name: 'Patrick Dodanim Castillo Flores', jobTitle: 'Ingeniero en Sistemas' },
  address: { '@type': 'PostalAddress', addressLocality: 'Alajuela', addressRegion: 'Alajuela', addressCountry: 'CR' },
  geo: { '@type': 'GeoCoordinates', latitude: 10.0162, longitude: -84.2116 },
  areaServed: [{ '@type': 'Country', name: 'Costa Rica' }],
  priceRange: '$$',
  currenciesAccepted: 'CRC',
  paymentAccepted: 'SINPE Móvil, Transferencia bancaria',
  availableLanguage: ['es', 'en'],
  openingHoursSpecification: {
    '@type': 'OpeningHoursSpecification',
    dayOfWeek: ['Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday'],
    opens: '09:00',
    closes: '17:00',
  },
  sameAs: [
    'https://www.instagram.com/teknikacr/',
    'https://www.facebook.com/profile.php?id=61591716943373',
    'https://www.tiktok.com/@teknikacr',
  ],
  hasOfferCatalog: {
    '@type': 'OfferCatalog',
    name: 'Servicios de Teknika CR',
    itemListElement: [
      { '@type': 'OfferCatalog', name: 'Asesoría y coaching en IA (personas)', itemListElement: planesIA.filter((p) => p.audiencia === 'personas').map(ofertaIA) },
      { '@type': 'OfferCatalog', name: 'Capacitación en IA (organizaciones)', itemListElement: planesIA.filter((p) => p.audiencia === 'organizaciones').map(ofertaIA) },
      {
        '@type': 'OfferCatalog',
        name: 'Desarrollo web para PYMEs',
        itemListElement: paquetesWeb.map((p) => ({
          '@type': 'Offer',
          itemOffered: { '@type': 'Service', name: p.nombre },
          price: String(p.precio),
          priceCurrency: 'CRC',
          valueAddedTaxIncluded: true,
        })),
      },
      {
        '@type': 'OfferCatalog',
        name: 'Soporte técnico',
        itemListElement: [
          { '@type': 'Offer', itemOffered: { '@type': 'Service', name: 'Diagnóstico de computadoras' }, price: '8000', priceCurrency: 'CRC' },
          { '@type': 'Offer', itemOffered: { '@type': 'Service', name: 'Paquete completo de formateo' }, price: '30000', priceCurrency: 'CRC' },
        ],
      },
    ],
  },
};

import { AGENDA_URL } from '../data/contacto';
import ContactModal from '../components/ContactModal.astro';
---

<!doctype html>
<html lang="es-CR">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <meta name="author" content="Teknika CR" />
    <meta name="robots" content={noindex ? "noindex, follow" : "index, follow"} />
    <meta name="theme-color" content="#122C34" />

    <title>{fullTitle}</title>

    {!noindex && <link rel="canonical" href={canonical} />}

    <!-- LLM discovery -->
    <link rel="alternate" type="text/plain" href="/llms.txt" title="LLM Information" />

    <!-- Favicon -->
    <link rel="icon" type="image/png" sizes="32x32" href="/img/favicon-32.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/img/apple-touch-icon.png" />

    <!-- DNS prefetch para servicios externos -->
    <link rel="dns-prefetch" href="https://formspree.io" />
    <link rel="dns-prefetch" href="https://wa.me" />

    <!-- Open Graph -->
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content="es_CR" />
    <meta property="og:site_name" content="Teknika CR" />
    <meta property="og:image" content={`${siteUrl}/img/og-teknika.png`} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Teknika CR - Asesoría, coaching y capacitación en IA" />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={`${siteUrl}/img/og-teknika.png`} />

    <!-- Fuentes (self-hosted via @fontsource/inter) -->

    <!-- Schema.org (precios de IA desde src/data/precios-ia.ts) -->
    <script type="application/ld+json" set:html={JSON.stringify(localBusiness)} />
    {breadcrumbSchema && <script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />}
    {schemas.map((sc) => <script type="application/ld+json" set:html={JSON.stringify(sc)} />)}

    <!-- Estilos -->
    <style is:global>
      @import '../styles/global.css';
    </style>
  </head>
  <body>
    <header class="header">
      <nav class="nav container">
        <a href="/" class="nav__logo">
          <img src="/img/logo-horizontal-light.svg" alt="Teknika CR" class="nav__logo-img" width="124" height="43" />
        </a>

        <button class="nav__toggle" aria-label="Abrir menú" aria-expanded="false">
          <span></span>
          <span></span>
          <span></span>
        </button>

        <ul class="nav__links" id="nav-links">
          <li><a href="/">Inicio</a></li>
          <li><a href="/capacitacion-ia/">Asesoría IA</a></li>
          <li><a href="/desarrollo-web/">Desarrollo Web</a></li>
          <li><a href="/servicios/">Soporte</a></li>
          <li><a href="/sobre/">Nosotros</a></li>
          <li><a href="/blog/">Blog</a></li>
          <li><a href="/contacto/">Contacto</a></li>
          <li>
            <a href={AGENDA_URL}
               class="btn btn--accent btn--nav"
               target="_blank"
               rel="noopener">
              Agendar llamada
            </a>
          </li>
        </ul>
      </nav>
    </header>

    <main>
      <slot />
    </main>

    <footer class="footer">
      <div class="container">
        <div class="footer__grid">
          <div class="footer__brand">
            <a href="/" class="footer__logo">
              <img src="/img/logo-horizontal-white.svg" alt="Teknika CR" class="footer__logo-img" width="138" height="48" />
            </a>
            <p class="footer__tagline">Tecnología que funciona.<br />Soluciones que entendés.</p>
          </div>

          <div class="footer__col">
            <h4>Servicios</h4>
            <ul>
              <li><a href="/capacitacion-ia/">Asesoría y coaching de IA</a></li>
              <li><a href="/aprender-ia/">Clases de IA para profesionales</a></li>
              <li><a href="/capacitacion-ia-empresas/">Capacitación de IA para empresas</a></li>
              <li><a href="/desarrollo-web/">Desarrollo web</a></li>
              <li><a href="/servicios/">Soporte técnico</a></li>
            </ul>
          </div>

          <div class="footer__col">
            <h4>Empresa</h4>
            <ul>
              <li><a href="/sobre/">Sobre nosotros</a></li>
              <li><a href="/blog/">Blog</a></li>
              <li><a href="/contacto/">Contacto</a></li>
            </ul>
          </div>

          <div class="footer__col">
            <h4>Contacto</h4>
            <ul>
              <li><a href="mailto:info@teknika.co.cr">info@teknika.co.cr</a></li>
              <li><a href="https://wa.me/50671951856" target="_blank" rel="noopener">WhatsApp</a></li>
              <li>Virtual en todo Costa Rica</li>
              <li>Atención en español e inglés</li>
            </ul>
            <div class="footer__social">
              <a href="https://www.instagram.com/teknikacr/" target="_blank" rel="noopener" aria-label="Instagram" class="footer__social-link">
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="2" y="2" width="20" height="20" rx="5" ry="5"/><path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"/><line x1="17.5" y1="6.5" x2="17.51" y2="6.5"/></svg>
              </a>
              <a href="https://www.facebook.com/profile.php?id=61591716943373" target="_blank" rel="noopener" aria-label="Facebook" class="footer__social-link">
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M18 2h-3a5 5 0 0 0-5 5v3H7v4h3v8h4v-8h3l1-4h-4V7a1 1 0 0 1 1-1h3z"/></svg>
              </a>
              <a href="https://www.tiktok.com/@teknikacr" target="_blank" rel="noopener" aria-label="TikTok" class="footer__social-link">
                <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M19.59 6.69a4.83 4.83 0 0 1-3.77-4.25V2h-3.45v13.67a2.89 2.89 0 0 1-2.88 2.5 2.89 2.89 0 0 1-2.89-2.89 2.89 2.89 0 0 1 2.89-2.89c.28 0 .54.04.79.1v-3.5a6.37 6.37 0 0 0-.79-.05A6.34 6.34 0 0 0 3.15 15a6.34 6.34 0 0 0 6.34 6.34 6.34 6.34 0 0 0 6.34-6.34V8.72a8.2 8.2 0 0 0 4.76 1.52V6.79a4.84 4.84 0 0 1-1-.1z"/></svg>
              </a>
            </div>
          </div>
        </div>

        <div class="footer__bottom">
          <p>&copy; {new Date().getFullYear()} Teknika CR. Todos los derechos reservados.</p>
        </div>
      </div>
    </footer>
    <ContactModal />

    <script>
      const toggle = document.querySelector('.nav__toggle');
      const links = document.getElementById('nav-links');
      if (toggle && links) {
        toggle.addEventListener('click', () => {
          const isOpen = links.classList.toggle('nav__links--open');
          toggle.setAttribute('aria-expanded', String(isOpen));
        });
      }
    </script>
  </body>
</html>

<style>
  /* ============================================
     Header & Nav
     ============================================ */
  .header {
    position: sticky;
    top: 0;
    z-index: 100;
    background: rgba(255, 255, 255, 0.95);
    backdrop-filter: blur(10px);
    border-bottom: 1px solid var(--color-gray-200);
  }

  .nav {
    display: flex;
    align-items: center;
    justify-content: space-between;
    height: 4rem;
  }

  .nav__logo {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    text-decoration: none;
    color: var(--color-dark);
    font-weight: 800;
    font-size: 1.25rem;
  }

  .nav__logo-img {
    width: auto;
    height: 40px;
    display: block;
  }



  .nav__links {
    display: flex;
    align-items: center;
    gap: var(--space-lg);
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .nav__links a {
    color: var(--color-gray-700);
    font-weight: 500;
    font-size: 0.9375rem;
    transition: color var(--transition);
  }

  .nav__links a:hover {
    color: var(--color-primary);
  }

  .btn--nav {
    padding: 0.5rem 1rem;
    font-size: 0.875rem;
  }

  .nav__toggle {
    display: none;
    flex-direction: column;
    gap: 5px;
    background: none;
    border: none;
    cursor: pointer;
    padding: 4px;
  }

  .nav__toggle span {
    display: block;
    width: 24px;
    height: 2px;
    background-color: var(--color-dark);
    border-radius: 2px;
    transition: transform var(--transition), opacity var(--transition);
  }

  /* ============================================
     Footer
     ============================================ */
  .footer {
    background-color: var(--color-dark);
    color: var(--color-gray-300);
    padding: var(--space-3xl) 0 var(--space-xl);
  }

  .footer__grid {
    display: grid;
    grid-template-columns: 2fr 1fr 1fr 1fr;
    gap: var(--space-2xl);
    margin-bottom: var(--space-2xl);
  }

  .footer__logo {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    text-decoration: none;
    font-weight: 800;
    font-size: 1.25rem;
  }

  .footer__logo-img {
    width: auto;
    height: 44px;
    display: block;
  }



  .footer__tagline {
    margin-top: var(--space-md);
    font-size: 0.9375rem;
    line-height: 1.6;
  }

  .footer__col h4 {
    color: var(--color-white);
    font-size: 0.9375rem;
    font-weight: 600;
    margin-bottom: var(--space-md);
  }

  .footer__col ul {
    list-style: none;
    padding: 0;
  }

  .footer__col li {
    margin-bottom: var(--space-sm);
    font-size: 0.875rem;
  }

  .footer__col a {
    color: var(--color-gray-300);
  }

  .footer__col a:hover {
    color: var(--color-cyan);
  }

  .footer__bottom {
    border-top: 1px solid var(--color-navy);
    padding-top: var(--space-lg);
    text-align: center;
    font-size: 0.8125rem;
    color: var(--color-gray-400);
  }

  .footer__bottom p {
    margin: 0;
  }

  .footer__social {
    display: flex;
    gap: var(--space-md);
    margin-top: var(--space-lg);
  }

  .footer__social-link {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 36px;
    height: 36px;
    border-radius: var(--radius-md);
    background: rgba(255, 255, 255, 0.08);
    color: var(--color-gray-300);
    transition: background-color var(--transition), color var(--transition), transform var(--transition);
  }

  .footer__social-link:hover {
    background: var(--color-cyan);
    color: var(--color-dark);
    transform: translateY(-2px);
  }

  /* ============================================
     Responsive
     ============================================ */
  @media (max-width: 768px) {
    .nav__toggle {
      display: flex;
    }

    .nav__links {
      display: none;
      position: absolute;
      top: 4rem;
      left: 0;
      right: 0;
      background: var(--color-white);
      flex-direction: column;
      padding: var(--space-lg);
      border-bottom: 1px solid var(--color-gray-200);
      box-shadow: var(--shadow-lg);
    }

    .nav__links--open {
      display: flex;
    }

    .footer__grid {
      grid-template-columns: 1fr 1fr;
      gap: var(--space-xl);
    }
  }

  @media (max-width: 480px) {
    .footer__grid {
      grid-template-columns: 1fr;
    }
  }
</style>
