---
import Base from '../layouts/Base.astro';
import HeroIllustration from '../components/HeroIllustration.astro';
import { colones, precioDesde } from '../data/precios-ia';
import { AGENDA_URL, WHATSAPP_URL } from '../data/contacto';
---

<Base
  title="Inicio"
  description="Asesoría, coaching y capacitación en inteligencia artificial para profesionales, PYMEs y organizaciones en Costa Rica. También desarrollo web y soporte técnico."
  canonical="https://teknika.co.cr"
>

  <!-- HERO -->
  <section class="hero">
    <div class="container">
      <div class="hero__grid">
        <div class="hero__content">
          <span class="badge badge--cyan">Asesoría y coaching en IA &middot; Costa Rica</span>
          <h1>Inteligencia artificial que funciona.<br /><span class="hero__accent">Explicada para que la entendás.</span></h1>
          <p class="hero__subtitle">
            Asesoría, coaching y capacitación en IA para profesionales, PYMEs y organizaciones.
            Aprendé a usar Claude, ChatGPT, Gemini y Copilot en tu trabajo real.
          </p>
          <div class="hero__actions">
            <a href={AGENDA_URL}
               class="btn btn--primary btn--lg"
               target="_blank"
               rel="noopener">
              Agendar una llamada
            </a>
            <a href="/capacitacion-ia" class="btn btn--outline-light btn--lg">
              Ver servicios de IA
            </a>
          </div>
        </div>
        <div class="hero__illustration">
          <HeroIllustration />
        </div>
      </div>
    </div>
  </section>

  <!-- SERVICIOS -->
  <section class="section section--alt" id="servicios">
    <div class="container">
      <div class="text-center" style="margin-bottom: var(--space-2xl);">
        <h2>Nuestros servicios</h2>
        <p class="text-muted">La IA es nuestro foco; también construimos sitios web y damos soporte técnico</p>
      </div>

      <div class="services-grid">
        <a href="/capacitacion-ia" class="card card--service card--service-featured">
          <div class="card-service__top">
            <div class="card__icon-circle">
              <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 2L2 7l10 5 10-5-10-5z"/><path d="M2 17l10 5 10-5"/><path d="M2 12l10 5 10-5"/></svg>
            </div>
            <div>
              <span class="badge badge--cyan">Servicio principal</span>
              <h3 class="card__title">Asesoría y coaching en IA</h3>
              <p class="card__price">1:1 desde {colones(precioDesde('personas'))} &middot; Equipos desde {colones(precioDesde('organizaciones'))}</p>
            </div>
          </div>
          <p class="card__text">
            Sesiones 1:1 y coaching para profesionales; talleres y programas para equipos.
            Con tus casos reales y sin jerga técnica.
          </p>
          <span class="card__cta">Ver formatos y precios &rarr;</span>
        </a>

        <a href="/desarrollo-web" class="card card--service">
          <div class="card-service__top">
            <div class="card__icon-circle">
              <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="10"/><line x1="2" y1="12" x2="22" y2="12"/><path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"/></svg>
            </div>
            <div>
              <h3 class="card__title">Desarrollo web</h3>
              <p class="card__price">Desde &#8353;120,000</p>
            </div>
          </div>
          <p class="card__text">
            Sitios web profesionales optimizados para Google y para la IA.
            Dominio, email profesional y hosting gratuito incluidos.
          </p>
          <span class="card__cta">Ver paquetes web &rarr;</span>
        </a>

        <a href="/servicios" class="card card--service">
          <div class="card-service__top">
            <div class="card__icon-circle">
              <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M14.7 6.3a1 1 0 0 0 0 1.4l1.6 1.6a1 1 0 0 0 1.4 0l3.77-3.77a6 6 0 0 1-7.94 7.94l-6.91 6.91a2.12 2.12 0 0 1-3-3l6.91-6.91a6 6 0 0 1 7.94-7.94l-3.76 3.76z"/></svg>
            </div>
            <div>
              <h3 class="card__title">Soporte técnico</h3>
              <p class="card__price">Desde &#8353;8,000</p>
            </div>
          </div>
          <p class="card__text">
            Diagnóstico, formateo, asesoría de compra y soporte para PYMEs.
            Presupuesto exacto antes de proceder.
          </p>
          <span class="card__cta">Ver servicios de soporte &rarr;</span>
        </a>
      </div>
    </div>
  </section>

  <!-- PROCESO -->
  <section class="section" id="proceso">
    <div class="container">
      <div class="text-center" style="margin-bottom: var(--space-2xl);">
        <h2>Cómo trabajamos</h2>
        <p class="text-muted">De la primera llamada a usar IA en tu día a día</p>
      </div>

      <div class="steps">
        <div class="step">
          <div class="step__number">1</div>
          <div class="step__connector"></div>
          <h3 class="step__title">Llamada corta</h3>
          <p class="step__text">Nos contás a qué te dedicás y qué querés lograr con IA. Te recomendamos el formato ideal.</p>
        </div>

        <div class="step">
          <div class="step__number">2</div>
          <div class="step__connector"></div>
          <h3 class="step__title">Plan a la medida</h3>
          <p class="step__text">Preparamos ejercicios con tus documentos, procesos y herramientas reales.</p>
        </div>

        <div class="step">
          <div class="step__number">3</div>
          <div class="step__connector"></div>
          <h3 class="step__title">Sesiones prácticas</h3>
          <p class="step__text">Aprendés haciendo, en vivo: virtual para personas, presencial o virtual para equipos.</p>
        </div>

        <div class="step">
          <div class="step__number">4</div>
          <h3 class="step__title">Seguimiento</h3>
          <p class="step__text">Te quedás con guías y plantillas de prompts, y soporte por chat según el plan.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- POR QUE TEKNIKA -->
  <section class="section section--dark" id="diferenciadores">
    <div class="container">
      <div class="text-center" style="margin-bottom: var(--space-2xl);">
        <h2>¿Por qué Teknika CR?</h2>
      </div>

      <div class="features-grid">
        <div class="feature">
          <div class="feature__icon-svg">
            <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/><line x1="8" y1="13" x2="16" y2="13"/><line x1="8" y1="17" x2="13" y2="17"/></svg>
          </div>
          <h3>Con tus propios casos</h3>
          <p>Practicamos con tus correos, documentos y procesos reales, no con ejemplos genéricos.</p>
        </div>
        <div class="feature">
          <div class="feature__icon-svg">
            <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/></svg>
          </div>
          <h3>Sin jerga técnica</h3>
          <p>Explicamos la IA en palabras simples. No necesitás saber de tecnología para empezar.</p>
        </div>
        <div class="feature">
          <div class="feature__icon-svg">
            <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 2L2 7l10 5 10-5-10-5z"/><path d="M2 17l10 5 10-5"/><path d="M2 12l10 5 10-5"/></svg>
          </div>
          <h3>Herramientas actuales</h3>
          <p>Claude, ChatGPT, Gemini y Copilot: te ayudamos a elegir la que encaja con lo que ya usás.</p>
        </div>
        <div class="feature">
          <div class="feature__icon-svg">
            <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/><polyline points="9 12 11 14 15 10"/></svg>
          </div>
          <h3>Uso responsable</h3>
          <p>Qué datos sí y qué datos no compartir con la IA, y cómo revisar lo que te responde.</p>
        </div>
        <div class="feature">
          <div class="feature__icon-svg">
            <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M16 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="8.5" cy="7" r="4"/><polyline points="17 11 19 13 23 9"/></svg>
          </div>
          <h3>Ingeniero en sistemas</h3>
          <p>Te acompaña un ingeniero que usa IA todos los días para desarrollar, escribir y analizar.</p>
        </div>
        <div class="feature">
          <div class="feature__icon-svg">
            <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><line x1="12" y1="1" x2="12" y2="23"/><path d="M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6"/></svg>
          </div>
          <h3>Precios publicados</h3>
          <p>Todos nuestros precios están en el sitio. Sabés cuánto pagás antes de empezar.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- CTA FINAL -->
  <section class="section cta-section">
    <div class="container text-center">
      <h2>¿Listo para trabajar con IA?</h2>
      <p class="cta-section__text">
        Agendá una llamada corta. Te recomendamos por dónde empezar, sin compromiso.
      </p>
      <div class="hero__actions" style="justify-content: center;">
        <a href={AGENDA_URL}
           class="btn btn--primary btn--lg"
           target="_blank"
           rel="noopener">
          Agendar una llamada
        </a>
        <a href={WHATSAPP_URL}
           class="btn btn--whatsapp btn--lg"
           target="_blank"
           rel="noopener">
          Escribir por WhatsApp
        </a>
      </div>
    </div>
  </section>


</Base>

<style>
  /* ============================================
     Hero
     ============================================ */
  .hero {
    background: linear-gradient(135deg, var(--color-dark) 0%, var(--color-navy) 50%, #1a3a5c 100%);
    color: var(--color-white);
    padding: var(--space-4xl) 0;
    min-height: 80vh;
    display: flex;
    align-items: center;
    overflow: hidden;
  }

  .hero__grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--space-2xl);
    align-items: center;
  }

  .hero__content {
    max-width: 600px;
  }

  .hero__illustration {
    display: flex;
    justify-content: center;
    align-items: center;
  }

  .hero h1 {
    color: var(--color-white);
    margin: var(--space-lg) 0;
  }

  .hero__accent {
    color: var(--color-cyan);
  }

  .hero__subtitle {
    font-size: 1.125rem;
    color: var(--color-gray-300);
    margin-bottom: var(--space-xl);
    line-height: 1.7;
  }

  .hero__actions {
    display: flex;
    gap: var(--space-md);
    flex-wrap: wrap;
  }

  /* btn--outline-dark moved to global.css */

  /* ============================================
     Services grid (fixed 3 columns)
     ============================================ */
  .services-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--space-xl);
  }

  a.card--service {
    display: block;
    color: inherit;
    text-decoration: none;
  }

  .card--service-featured {
    border: 2px solid var(--color-cyan);
  }

  .card--service-featured .badge {
    margin-bottom: var(--space-xs);
  }

  /* ============================================
     Service Cards (improved)
     ============================================ */
  .card--service {
    cursor: pointer;
    position: relative;
    padding: var(--space-xl);
    padding-bottom: calc(var(--space-xl) + 2rem);
    border: 1px solid var(--color-gray-200);
    border-radius: var(--radius-lg);
    background: var(--color-white);
    transition: transform 200ms ease, box-shadow 200ms ease, border-color 200ms ease;
    box-shadow: var(--shadow-sm);
  }

  .card--service:hover {
    border-color: var(--color-sky);
    box-shadow: var(--shadow-lg);
    transform: translateY(-4px);
  }

  .card--service:focus-visible {
    outline: 2px solid var(--color-sky);
    outline-offset: 2px;
  }

  .card-service__top {
    display: flex;
    align-items: center;
    gap: var(--space-md);
    margin-bottom: var(--space-md);
  }

  .card__icon-circle {
    width: 48px;
    height: 48px;
    display: flex;
    align-items: center;
    justify-content: center;
    background: linear-gradient(135deg, var(--color-royal), var(--color-sky));
    color: var(--color-white);
    border-radius: var(--radius-lg);
    flex-shrink: 0;
  }

  .card__title {
    font-size: 1.125rem;
    margin-bottom: 0;
    line-height: 1.3;
  }

  .card__price {
    font-size: 0.8125rem;
    color: var(--color-cyan-text);
    font-weight: 600;
    margin: 2px 0 0;
  }

  .card__text {
    color: var(--color-text-muted);
    font-size: 0.9375rem;
    margin-bottom: 0;
    line-height: 1.6;
  }

  .card__cta {
    position: absolute;
    bottom: var(--space-lg);
    left: var(--space-xl);
    font-size: 0.875rem;
    font-weight: 600;
    color: var(--color-royal);
    transition: color var(--transition), transform var(--transition);
  }

  .card--service:hover .card__cta {
    color: var(--color-sky);
    transform: translateX(4px);
  }

  /* ============================================
     Steps (improved with connectors)
     ============================================ */
  .steps {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 0;
    counter-reset: step;
  }

  .step {
    text-align: center;
    position: relative;
    padding: 0 var(--space-md);
  }

  .step__number {
    width: 52px;
    height: 52px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    background: linear-gradient(135deg, var(--color-royal), var(--color-sky));
    color: var(--color-white);
    border-radius: var(--radius-full);
    font-weight: 800;
    font-size: 1.25rem;
    margin-bottom: var(--space-md);
    position: relative;
    z-index: 1;
    box-shadow: 0 4px 12px rgba(42, 68, 148, 0.3);
  }

  .step__connector {
    position: absolute;
    top: 26px;
    left: calc(50% + 30px);
    width: calc(100% - 60px);
    height: 2px;
    background: linear-gradient(90deg, var(--color-sky), var(--color-gray-200));
    z-index: 0;
  }

  .step:last-child .step__connector {
    display: none;
  }

  .step__title {
    font-size: 1.0625rem;
    margin-bottom: var(--space-xs);
  }

  .step__text {
    color: var(--color-text-muted);
    font-size: 0.875rem;
    line-height: 1.5;
  }

  /* ============================================
     Features (dark section, 3x2 grid with SVG icons)
     ============================================ */
  .features-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--space-xl);
  }

  .feature {
    text-align: center;
    padding: var(--space-xl) var(--space-lg);
    border-radius: var(--radius-lg);
    border: 1px solid rgba(255, 255, 255, 0.06);
    transition: background-color 200ms ease, border-color 200ms ease, transform 200ms ease;
  }

  .feature:hover {
    background: rgba(255, 255, 255, 0.05);
    border-color: rgba(68, 207, 203, 0.2);
    transform: translateY(-2px);
  }

  .feature__icon-svg {
    width: 56px;
    height: 56px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    background: rgba(68, 207, 203, 0.1);
    border: 1px solid rgba(68, 207, 203, 0.2);
    border-radius: var(--radius-lg);
    margin: 0 auto var(--space-md);
    color: var(--color-cyan);
  }

  .feature h3 {
    color: var(--color-cyan);
    font-size: 1.0625rem;
    margin-bottom: var(--space-sm);
  }

  .feature p {
    color: var(--color-gray-300);
    font-size: 0.9375rem;
    margin-bottom: 0;
    line-height: 1.6;
  }

  /* ============================================
     CTA
     ============================================ */
  .cta-section {
    background: linear-gradient(135deg, var(--color-gray-50) 0%, var(--color-gray-100) 100%);
  }

  .cta-section__text {
    font-size: 1.125rem;
    color: var(--color-text-muted);
    max-width: 500px;
    margin: var(--space-md) auto var(--space-xl);
  }

  /* ============================================
     Responsive
     ============================================ */
  @media (max-width: 768px) {
    .hero {
      min-height: auto;
      padding: var(--space-3xl) 0;
    }

    .hero__grid {
      grid-template-columns: 1fr;
      text-align: center;
    }

    .hero__illustration {
      order: -1;
    }

    .hero__actions {
      justify-content: center;
    }

    .steps {
      grid-template-columns: 1fr 1fr;
      gap: var(--space-xl);
    }

    .step__connector {
      display: none;
    }

    .services-grid {
      grid-template-columns: 1fr;
    }

    .grid--3 {
      grid-template-columns: 1fr;
    }

    .features-grid {
      grid-template-columns: 1fr;
    }
  }

  @media (min-width: 769px) and (max-width: 1024px) {
    .services-grid {
      grid-template-columns: repeat(2, 1fr);
    }

    .features-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 480px) {
    .steps {
      grid-template-columns: 1fr;
    }
  }
</style>
