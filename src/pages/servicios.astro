---
import Base from '../layouts/Base.astro';
import ContactModal from '../components/ContactModal.astro';
---

<Base
  title="Servicios"
  description="Servicios de soporte técnico, reparación de computadoras, formateo, instalación de software, asesoría de IA y desarrollo web en Costa Rica."
  canonical="https://teknika.co.cr/servicios"
>

  <section class="page-header">
    <div class="container">
      <h1>Nuestros servicios</h1>
      <p>Soluciones informáticas claras, con precios transparentes</p>
    </div>
  </section>

  <!-- MODALIDADES -->
  <section class="section section--alt" id="modalidades">
    <div class="container">
      <div class="text-center" style="margin-bottom: var(--space-2xl);">
        <h2>¿Cómo recibimos tu equipo?</h2>
        <p class="text-muted">Tres formas de atenderte desde Alajuela</p>
      </div>

      <div class="grid grid--3">
        <div class="card svc-card" style="text-align: center;">
          <div class="svc-card__emoji">&#128230;</div>
          <h3 class="svc-card__title">Dejá y recogé</h3>
          <p class="svc-card__desc">Traé tu equipo a nuestro punto base en Alajuela y recogelo cuando esté listo.</p>
          <p class="svc-card__price-highlight">Sin costo extra</p>
        </div>
        <div class="card svc-card" style="text-align: center;">
          <div class="svc-card__emoji">&#128666;</div>
          <h3 class="svc-card__title">Envío a domicilio</h3>
          <p class="svc-card__desc">Enviá tu equipo por mensajería. Lo reparamos y te lo devolvemos a tu puerta. Cobertura en todo el GAM.</p>
          <p class="svc-card__price-highlight">Desde &#8353;3,000</p>
        </div>
        <div class="card svc-card" style="text-align: center;">
          <div class="svc-card__emoji">&#127968;</div>
          <h3 class="svc-card__title">Visita a domicilio</h3>
          <p class="svc-card__desc">Vamos a tu casa u oficina. Disponible en Alajuela, Heredia, Belén, San Antonio, Santa Bárbara y alrededores.</p>
          <p class="svc-card__price-highlight">Alajuela: gratis &middot; Heredia y alrededores: desde &#8353;3,000</p>
        </div>
      </div>
    </div>
  </section>

  <!-- DIAGNOSTICO -->
  <section class="section" id="diagnostico">
    <div class="container">
      <div class="svc-section__header">
        <h2>&#128269; Diagnóstico y reparación</h2>
        <p class="text-muted">Laptops y desktops &mdash; No celulares</p>
      </div>

      <div class="grid grid--3">
        <div class="card svc-card svc-card--clickable" data-service="Diagnóstico básico (software)" role="button" tabindex="0">
          <h3 class="svc-card__title">Diagnóstico básico</h3>
          <p class="svc-card__subtitle">Software</p>
          <p class="svc-card__desc">Revisamos el sistema operativo, programas, rendimiento y detectamos problemas de software.</p>
          <p class="svc-card__price">Desde &#8353;8,000</p>
          <span class="svc-card__cta">Consultar &rarr;</span>
        </div>

        <div class="card svc-card svc-card--clickable" data-service="Diagnóstico avanzado (hardware)" role="button" tabindex="0">
          <h3 class="svc-card__title">Diagnóstico avanzado</h3>
          <p class="svc-card__subtitle">Hardware</p>
          <p class="svc-card__desc">Apertura del equipo, revisión de componentes internos, temperaturas y estado del disco.</p>
          <p class="svc-card__price">Desde &#8353;15,000</p>
          <span class="svc-card__cta">Consultar &rarr;</span>
        </div>

        <div class="card svc-card svc-card--clickable" data-service="Limpieza interna + pasta térmica" role="button" tabindex="0">
          <h3 class="svc-card__title">Limpieza interna</h3>
          <p class="svc-card__subtitle">+ pasta térmica</p>
          <p class="svc-card__desc">Limpieza completa de polvo, cambio de pasta térmica. Tu equipo baja temperaturas y rinde mejor.</p>
          <p class="svc-card__price">Desde &#8353;12,000</p>
          <span class="svc-card__cta">Consultar &rarr;</span>
        </div>

        <div class="card svc-card svc-card--clickable" data-service="Cambio/upgrade de RAM" role="button" tabindex="0">
          <h3 class="svc-card__title">Upgrade de RAM</h3>
          <p class="svc-card__subtitle">Más memoria, más velocidad</p>
          <p class="svc-card__desc">Instalamos o ampliamos la memoria RAM de tu computadora para que funcione más fluida.</p>
          <p class="svc-card__price">&#8353;8,000 + costo del componente</p>
          <span class="svc-card__cta">Consultar &rarr;</span>
        </div>

        <div class="card svc-card svc-card--clickable" data-service="Cambio de HDD a SSD (incluye clonación de datos)" role="button" tabindex="0">
          <h3 class="svc-card__title">Cambio a SSD</h3>
          <p class="svc-card__subtitle">Incluye clonación de datos</p>
          <p class="svc-card__desc">Reemplazamos tu disco duro por un SSD. Tu computadora enciende en segundos y todo carga más rápido.</p>
          <p class="svc-card__price">&#8353;10,000 + costo del componente</p>
          <span class="svc-card__cta">Consultar &rarr;</span>
        </div>

        <div class="card svc-card svc-card--clickable" data-service="Reparación de software (virus, lentitud)" role="button" tabindex="0">
          <h3 class="svc-card__title">Reparación de software</h3>
          <p class="svc-card__subtitle">Virus, lentitud, errores</p>
          <p class="svc-card__desc">Eliminamos malware, reparamos errores del sistema y optimizamos el rendimiento sin formatear.</p>
          <p class="svc-card__price">Desde &#8353;10,000</p>
          <span class="svc-card__cta">Consultar &rarr;</span>
        </div>
      </div>

      <p class="pricing-note">El costo del diagnóstico se aplica al total si se procede con la reparación.</p>
    </div>
  </section>

  <!-- FORMATEO -->
  <section class="section section--alt" id="formateo">
    <div class="container">
      <div class="svc-section__header">
        <h2>&#128187; Formateo e instalación</h2>
        <p class="text-muted">Instalación limpia con todo lo que necesitás</p>
      </div>

      <div class="grid grid--3">
        <div class="card svc-card svc-card--clickable" data-service="Formateo + instalación de Windows" role="button" tabindex="0">
          <h3 class="svc-card__title">Windows</h3>
          <p class="svc-card__subtitle">Formateo + instalación</p>
          <p class="svc-card__desc">Instalación limpia de Windows 10/11 con drivers, actualizaciones y configuración básica.</p>
          <p class="svc-card__price">Desde &#8353;15,000</p>
          <span class="svc-card__cta">Consultar &rarr;</span>
        </div>

        <div class="card svc-card svc-card--clickable" data-service="Formateo + instalación de Linux" role="button" tabindex="0">
          <h3 class="svc-card__title">Linux</h3>
          <p class="svc-card__subtitle">Ubuntu, Mint y más</p>
          <p class="svc-card__desc">Instalación de distribuciones Linux configuradas y listas para usar.</p>
          <p class="svc-card__price">Desde &#8353;12,000</p>
          <span class="svc-card__cta">Consultar &rarr;</span>
        </div>

        <div class="card svc-card svc-card--clickable" data-service="Instalación de suite Office" role="button" tabindex="0">
          <h3 class="svc-card__title">Suite Office</h3>
          <p class="svc-card__subtitle">Word, Excel, PowerPoint</p>
          <p class="svc-card__desc">Instalación y configuración de Microsoft Office o alternativas gratuitas.</p>
          <p class="svc-card__price">&#8353;5,000</p>
          <span class="svc-card__cta">Consultar &rarr;</span>
        </div>

        <div class="card svc-card svc-card--clickable" data-service="Backup de datos (respaldo de archivos)" role="button" tabindex="0">
          <h3 class="svc-card__title">Backup de datos</h3>
          <p class="svc-card__subtitle">Respaldo de tus archivos</p>
          <p class="svc-card__desc">Copiamos todos tus documentos, fotos, videos y archivos importantes a un disco externo o la nube antes de formatear o reparar. Nada se pierde.</p>
          <p class="svc-card__price">Desde &#8353;8,000</p>
          <span class="svc-card__cta">Consultar &rarr;</span>
        </div>

        <div class="card svc-card svc-card--clickable svc-card--featured" data-service="Paquete Completo (Formateo + Office + Antivirus + Backup) - Desde ₡30,000" role="button" tabindex="0">
          <span class="badge badge--cyan">Mejor valor</span>
          <h3 class="svc-card__title">Paquete Completo</h3>
          <p class="svc-card__subtitle">El combo más solicitado</p>
          <p class="svc-card__price">Desde &#8353;30,000</p>
          <ul class="svc-card__list">
            <li>Formateo + instalación de Windows o Linux</li>
            <li>Backup de todos tus archivos</li>
            <li>Suite Office instalada</li>
            <li>Antivirus configurado</li>
            <li>Drivers y actualizaciones</li>
          </ul>
          <p class="svc-card__save">Tu equipo como nuevo</p>
          <span class="svc-card__cta">Pedir paquete &rarr;</span>
        </div>
      </div>
    </div>
  </section>

  <!-- ASESORIA COMPRA -->
  <section class="section" id="asesoria">
    <div class="container">
      <div class="svc-section__header">
        <h2>&#128176; Asesoría de compra</h2>
        <p class="text-muted">Te ayudamos a tomar la mejor decisión</p>
      </div>

      <div class="grid grid--3">
        <div class="card svc-card svc-card--clickable" data-service="Asesoría de compra por chat (gratis)" role="button" tabindex="0">
          <h3 class="svc-card__title">Asesoría por chat</h3>
          <p class="svc-card__subtitle">WhatsApp, sin límite</p>
          <p class="svc-card__desc">Escribinos tus dudas y te orientamos sobre qué equipo comprar según tu presupuesto.</p>
          <p class="svc-card__price svc-card__price--free">GRATIS</p>
          <span class="svc-card__cta">Escribir ahora &rarr;</span>
        </div>

        <div class="card svc-card svc-card--clickable" data-service="Asesoría de compra por llamada (30 min)" role="button" tabindex="0">
          <h3 class="svc-card__title">Asesoría por llamada</h3>
          <p class="svc-card__subtitle">30 minutos</p>
          <p class="svc-card__desc">Llamada telefónica personalizada para analizar opciones y darte una recomendación clara.</p>
          <p class="svc-card__price">&#8353;5,000</p>
          <span class="svc-card__cta">Agendar llamada &rarr;</span>
        </div>

        <div class="card svc-card svc-card--clickable" data-service="Asesoría completa de compra (análisis + recomendación escrita)" role="button" tabindex="0">
          <h3 class="svc-card__title">Asesoría completa</h3>
          <p class="svc-card__subtitle">Análisis + informe escrito</p>
          <p class="svc-card__desc">Evaluamos tus necesidades, comparamos opciones del mercado y te entregamos una recomendación documentada.</p>
          <p class="svc-card__price">Desde &#8353;8,000</p>
          <span class="svc-card__cta">Consultar &rarr;</span>
        </div>

        <div class="card svc-card svc-card--clickable" data-service="Acompañamiento de compra presencial" role="button" tabindex="0">
          <h3 class="svc-card__title">Acompañamiento de compra</h3>
          <p class="svc-card__subtitle">Presencial en Alajuela y Heredia</p>
          <p class="svc-card__desc">Vamos con vos a la tienda o revisamos la compra en línea para que no te vendan de más.</p>
          <p class="svc-card__price">&#8353;10,000</p>
          <span class="svc-card__cta">Agendar &rarr;</span>
        </div>

        <div class="card svc-card svc-card--clickable" data-service="Configuración inicial de equipo nuevo" role="button" tabindex="0">
          <h3 class="svc-card__title">Configuración de equipo nuevo</h3>
          <p class="svc-card__subtitle">Dejálo listo para usar</p>
          <p class="svc-card__desc">Instalamos todo lo que necesitás en tu equipo nuevo: programas, cuentas, impresora, respaldo.</p>
          <p class="svc-card__price">Desde &#8353;10,000</p>
          <span class="svc-card__cta">Consultar &rarr;</span>
        </div>
      </div>
    </div>
  </section>

  <!-- PAQUETES SOPORTE -->
  <section class="section section--alt" id="paquetes">
    <div class="container">
      <div class="svc-section__header">
        <h2>&#127873; Paquetes con descuento</h2>
        <p class="text-muted">Ahorrá combinando servicios</p>
      </div>

      <div class="grid grid--3">
        <div class="card svc-card svc-card--clickable" data-service="Paquete Básico (Diagnóstico + Limpieza) - ₡18,000" role="button" tabindex="0">
          <span class="badge badge--sky">Básico</span>
          <h3 class="svc-card__title">Paquete Básico</h3>
          <p class="svc-card__price">&#8353;18,000</p>
          <ul class="svc-card__list">
            <li>Diagnóstico completo</li>
            <li>Limpieza interna</li>
          </ul>
          <p class="svc-card__save">Ahorro ~15% vs individual</p>
          <span class="svc-card__cta">Pedir paquete &rarr;</span>
        </div>

        <div class="card svc-card svc-card--clickable svc-card--featured" data-service="Paquete Completo (Formateo + Backup + Office + Antivirus + Limpieza) - ₡45,000" role="button" tabindex="0">
          <span class="badge badge--cyan">Mejor valor</span>
          <h3 class="svc-card__title">Paquete Completo</h3>
          <p class="svc-card__price">&#8353;45,000</p>
          <ul class="svc-card__list">
            <li>Formateo + instalación OS</li>
            <li>Backup de datos</li>
            <li>Suite Office</li>
            <li>Antivirus</li>
            <li>Limpieza interna</li>
          </ul>
          <p class="svc-card__save">Ahorro ~20% vs individual</p>
          <span class="svc-card__cta">Pedir paquete &rarr;</span>
        </div>

        <div class="card svc-card svc-card--clickable" data-service="Paquete Nuevo Equipo (Asesoría + Configuración) - ₡18,000" role="button" tabindex="0">
          <span class="badge badge--sky">Nuevo equipo</span>
          <h3 class="svc-card__title">Paquete Nuevo Equipo</h3>
          <p class="svc-card__price">&#8353;18,000</p>
          <ul class="svc-card__list">
            <li>Asesoría de compra</li>
            <li>Configuración inicial</li>
          </ul>
          <p class="svc-card__save">Ahorro ~25% vs individual</p>
          <span class="svc-card__cta">Pedir paquete &rarr;</span>
        </div>
      </div>
    </div>
  </section>

  <!-- SOPORTE PYMES -->
  <section class="section" id="pymes">
    <div class="container">
      <div class="svc-section__header">
        <h2>&#128188; Soporte para PYMEs</h2>
        <p class="text-muted">Tu departamento de TI sin tener que contratar uno</p>
      </div>

      <p class="svc-intro">
        Sabemos que las pequeñas y medianas empresas no pueden tener un técnico de planta.
        Con Teknika CR tenés soporte técnico recurrente, mantenimiento preventivo y asesoría
        informática cuando lo necesités, a una fracción del costo de un empleado.
      </p>

      <div class="grid grid--3">
        <div class="card svc-card svc-card--clickable" data-service="Plan PYME Básico - Soporte técnico mensual - Desde ₡20,000/mes" role="button" tabindex="0">
          <span class="badge badge--sky">Básico</span>
          <h3 class="svc-card__title">Plan PYME Básico</h3>
          <p class="svc-card__price">Desde &#8353;20,000/mes</p>
          <ul class="svc-card__list">
            <li>Hasta 3 equipos</li>
            <li>Soporte remoto ilimitado</li>
            <li>1 visita presencial/mes</li>
            <li>Tiempo de respuesta: 24h</li>
          </ul>
          <span class="svc-card__cta">Consultar &rarr;</span>
        </div>

        <div class="card svc-card svc-card--clickable svc-card--featured" data-service="Plan PYME Profesional - Soporte técnico mensual - Desde ₡45,000/mes" role="button" tabindex="0">
          <span class="badge badge--cyan">Más popular</span>
          <h3 class="svc-card__title">Plan PYME Profesional</h3>
          <p class="svc-card__price">Desde &#8353;45,000/mes</p>
          <ul class="svc-card__list">
            <li>Hasta 10 equipos</li>
            <li>Soporte remoto ilimitado</li>
            <li>2 visitas presenciales/mes</li>
            <li>Mantenimiento preventivo</li>
            <li>Tiempo de respuesta: 12h</li>
          </ul>
          <span class="svc-card__cta">Consultar &rarr;</span>
        </div>

        <div class="card svc-card svc-card--clickable" data-service="Plan PYME a medida - Soporte técnico personalizado" role="button" tabindex="0">
          <span class="badge badge--sky">A medida</span>
          <h3 class="svc-card__title">Plan personalizado</h3>
          <p class="svc-card__price">Cotizar</p>
          <ul class="svc-card__list">
            <li>Más de 10 equipos</li>
            <li>Soporte remoto + presencial</li>
            <li>Visitas según necesidad</li>
            <li>Asesoría informática integral</li>
            <li>Tiempo de respuesta: 4h</li>
          </ul>
          <span class="svc-card__cta">Solicitar cotización &rarr;</span>
        </div>
      </div>
    </div>
  </section>

  <!-- ASESORIA IA -->
  <section class="section" id="ia">
    <div class="container">
      <div class="svc-section__header">
        <h2>&#129302; Asesoría de inteligencia artificial</h2>
        <p class="text-muted">Aprendé a usar IA en tu trabajo o vida personal</p>
      </div>

      <p class="svc-intro">
        La inteligencia artificial ya está cambiando la forma en que trabajamos. Te enseñamos
        a usarla de forma práctica: desde generar contenido, automatizar tareas, hasta analizar
        datos. Sesiones personalizadas, sin jerga técnica, enfocadas en lo que vos necesitás.
      </p>

      <div class="grid grid--3">
        <div class="card svc-card svc-card--clickable" data-service="Sesión de IA - 1 hora de aprendizaje virtual - ₡15,000" role="button" tabindex="0">
          <span class="badge badge--sky">Individual</span>
          <h3 class="svc-card__title">Sesión básica</h3>
          <p class="svc-card__subtitle">Virtual &middot; 1 hora</p>
          <p class="svc-card__price">&#8353;15,000</p>
          <ul class="svc-card__list">
            <li>1 hora de sesión virtual en vivo</li>
            <li>Aprendizaje acompañado y práctico</li>
            <li>Personalizado a tu trabajo o necesidad</li>
          </ul>
          <span class="svc-card__cta">Agendar sesión &rarr;</span>
        </div>

        <div class="card svc-card svc-card--clickable svc-card--featured" data-service="Bundle de IA - 6 horas de tutoría virtual - ₡75,000" role="button" tabindex="0">
          <span class="badge badge--cyan">Mejor valor</span>
          <h3 class="svc-card__title">Bundle 6 sesiones</h3>
          <p class="svc-card__subtitle">Virtual &middot; Usálas a tu ritmo</p>
          <p class="svc-card__price">&#8353;75,000</p>
          <ul class="svc-card__list">
            <li>6 horas de tutoría virtual</li>
            <li>Plan de aprendizaje personalizado</li>
            <li>Soporte por chat entre sesiones</li>
            <li>Recursos y guías incluidas</li>
          </ul>
          <p class="svc-card__save">Ahorro de &#8353;15,000 vs individual</p>
          <span class="svc-card__cta">Agendar tutoría &rarr;</span>
        </div>

        <div class="card svc-card svc-card--clickable" data-service="Capacitación grupal de IA para empresa - ₡10,000/persona (mínimo 4 personas)" role="button" tabindex="0">
          <span class="badge badge--sky">Empresas</span>
          <h3 class="svc-card__title">Capacitación grupal</h3>
          <p class="svc-card__subtitle">Virtual o presencial &middot; 2 horas</p>
          <p class="svc-card__price">&#8353;10,000/persona</p>
          <ul class="svc-card__list">
            <li>Sesión de 2 horas para equipos de trabajo</li>
            <li>Mínimo 4 participantes</li>
            <li>Virtual o presencial según necesidad</li>
            <li>Material de apoyo para cada participante</li>
          </ul>
          <span class="svc-card__cta">Solicitar cotización &rarr;</span>
        </div>
      </div>
    </div>
  </section>

  <!-- SITIOS WEB -->
  <section class="section section--alt" id="web">
    <div class="container">
      <div class="svc-section__header">
        <h2>&#127760; Tu negocio en internet</h2>
        <p class="text-muted">Sitios web profesionales para PYMEs &mdash; sin cuotas de hosting</p>
      </div>

      <div class="grid grid--3">
        <div class="card svc-card svc-card--clickable" data-service="Presencia Digital (Landing page + dominio) - Desde ₡120,000" role="button" tabindex="0">
          <span class="badge badge--sky">Landing</span>
          <h3 class="svc-card__title">Presencia Digital</h3>
          <p class="svc-card__price">Desde &#8353;120,000</p>
          <ul class="svc-card__list">
            <li>1 página profesional</li>
            <li>Formulario de contacto</li>
            <li>Diseño responsive</li>
            <li>SSL y hosting gratis</li>
            <li>Dominio incluido (1 año)</li>
          </ul>
          <p class="svc-card__save">Entrega en 1 semana</p>
          <span class="svc-card__cta">Cotizar &rarr;</span>
        </div>

        <div class="card svc-card svc-card--clickable svc-card--featured" data-service="Sitio Profesional (3-5 páginas + Blog + SEO) - Desde ₡250,000" role="button" tabindex="0">
          <span class="badge badge--cyan">Más popular</span>
          <h3 class="svc-card__title">Sitio Profesional</h3>
          <p class="svc-card__price">Desde &#8353;250,000</p>
          <ul class="svc-card__list">
            <li>3-5 páginas completas</li>
            <li>Blog integrado</li>
            <li>SEO básico + Google My Business</li>
            <li>Botón de WhatsApp</li>
            <li>Email profesional</li>
            <li>Hosting gratis</li>
          </ul>
          <p class="svc-card__save">Entrega en 2 semanas</p>
