---
import Base from '../layouts/Base.astro';
import ContactModal from '../components/ContactModal.astro';
---

<Base
  title="Ofertas"
  description="Paquetes y ofertas de Teknika CR: combiná servicios y ahorrá. Soporte técnico, formateo, asesoría de IA y desarrollo web en Costa Rica."
  canonical="https://teknika.co.cr/ofertas"
>

  <section class="page-header">
    <div class="container">
      <h1>Ofertas y paquetes</h1>
      <p>Combiná servicios y ahorrá. Todos los bundles en un solo lugar.</p>
    </div>
  </section>

  <!-- PAQUETES SOPORTE -->
  <section class="section" id="soporte">
    <div class="container">
      <div class="ofertas-section__header">
        <h2>&#128187; Paquetes de soporte técnico</h2>
        <p class="text-muted">Combiná diagnóstico, formateo y configuración con descuento</p>
      </div>

      <div class="grid grid--3">
        <div class="card svc-card svc-card--clickable" data-service="Paquete Básico (Diagnóstico + Limpieza) - ₡13,500" role="button" tabindex="0">
          <span class="badge badge--sky">Básico</span>
          <h3 class="svc-card__title">Paquete Básico</h3>
          <p class="svc-card__price"><span class="price-original">&#8353;18,000</span> <span class="price-launch">&#8353;13,500</span><span class="launch-tag">-25%</span></p>
          <ul class="svc-card__list">
            <li>Diagnóstico completo</li>
            <li>Limpieza interna + pasta térmica</li>
          </ul>
          <p class="svc-card__save">Ahorro ~15% vs individual</p>
          <span class="svc-card__cta">Pedir paquete &rarr;</span>
        </div>

        <div class="card svc-card svc-card--clickable svc-card--featured" data-service="Paquete Completo (Formateo + Backup + Office + Antivirus + Limpieza) - ₡22,500" role="button" tabindex="0">
          <span class="badge badge--cyan">Más vendido</span>
          <h3 class="svc-card__title">Paquete Completo</h3>
          <p class="svc-card__price"><span class="price-original">&#8353;30,000</span> <span class="price-launch">&#8353;22,500</span><span class="launch-tag">-25%</span></p>
          <ul class="svc-card__list">
            <li>Formateo + instalación de Windows o Linux</li>
            <li>Backup de todos tus archivos</li>
            <li>Suite Office instalada</li>
            <li>Antivirus configurado</li>
            <li>Limpieza interna + pasta térmica</li>
            <li>Drivers y actualizaciones</li>
          </ul>
          <p class="svc-card__save">Ahorro ~20% &middot; Tu equipo como nuevo</p>
          <span class="svc-card__cta">Pedir paquete &rarr;</span>
        </div>

        <div class="card svc-card svc-card--clickable" data-service="Paquete Nuevo Equipo (Asesoría + Configuración) - ₡13,500" role="button" tabindex="0">
          <span class="badge badge--sky">Equipo nuevo</span>
          <h3 class="svc-card__title">Paquete Nuevo Equipo</h3>
          <p class="svc-card__price"><span class="price-original">&#8353;18,000</span> <span class="price-launch">&#8353;13,500</span><span class="launch-tag">-25%</span></p>
          <ul class="svc-card__list">
            <li>Asesoría de compra personalizada</li>
            <li>Configuración inicial completa</li>
            <li>Instalación de programas esenciales</li>
          </ul>
          <p class="svc-card__save">Ahorro ~25% vs individual</p>
          <span class="svc-card__cta">Pedir paquete &rarr;</span>
        </div>
      </div>
    </div>
  </section>

  <!-- PAQUETES IA -->
  <section class="section section--alt" id="ia">
    <div class="container">
      <div class="ofertas-section__header">
        <h2>&#129302; Paquetes de inteligencia artificial</h2>
        <p class="text-muted">Aprendé a usar IA de forma práctica con sesiones personalizadas</p>
      </div>

      <div class="grid grid--3">
        <div class="card svc-card svc-card--clickable" data-service="Sesión de IA - 1 hora de aprendizaje virtual - ₡11,250" role="button" tabindex="0">
          <span class="badge badge--sky">Individual</span>
          <h3 class="svc-card__title">Sesión básica</h3>
          <p class="svc-card__subtitle">Virtual &middot; 1 hora</p>
          <p class="svc-card__price"><span class="price-original">&#8353;15,000</span> <span class="price-launch">&#8353;11,250</span><span class="launch-tag">-25%</span></p>
          <ul class="svc-card__list">
            <li>1 hora de sesión virtual en vivo</li>
            <li>Aprendizaje acompañado y práctico</li>
            <li>Personalizado a tu trabajo o necesidad</li>
            <li>Herramientas: ChatGPT, Claude, Gemini y más</li>
          </ul>
          <span class="svc-card__cta">Agendar sesión &rarr;</span>
        </div>

        <div class="card svc-card svc-card--clickable svc-card--featured" data-service="Bundle de IA - 6 horas de tutoría virtual - ₡56,250" role="button" tabindex="0">
          <span class="badge badge--cyan">Mejor valor</span>
          <h3 class="svc-card__title">Bundle 6 sesiones</h3>
          <p class="svc-card__subtitle">Virtual &middot; Usálas a tu ritmo</p>
          <p class="svc-card__price"><span class="price-original">&#8353;75,000</span> <span class="price-launch">&#8353;56,250</span><span class="launch-tag">-25%</span></p>
          <ul class="svc-card__list">
            <li>6 horas de tutoría virtual</li>
            <li>Plan de aprendizaje personalizado</li>
            <li>Soporte por chat entre sesiones</li>
            <li>Recursos y guías incluidas</li>
            <li>Seguimiento de tu progreso</li>
          </ul>
          <p class="svc-card__save">Ahorrás &#8353;15,000 vs 6 sesiones individuales</p>
          <span class="svc-card__cta">Agendar tutoría &rarr;</span>
        </div>

        <div class="card svc-card svc-card--clickable" data-service="Capacitación grupal de IA para empresa - ₡7,500/persona (mínimo 4 personas)" role="button" tabindex="0">
          <span class="badge badge--sky">Empresas</span>
          <h3 class="svc-card__title">Capacitación grupal</h3>
          <p class="svc-card__subtitle">Virtual o presencial &middot; 2 horas</p>
          <p class="svc-card__price"><span class="price-original">&#8353;10,000</span> <span class="price-launch">&#8353;7,500</span><span class="launch-tag">-25%</span><span style="font-size: 0.75em; font-weight: 500;">/persona</span></p>
          <ul class="svc-card__list">
            <li>Sesión de 2 horas para equipos de trabajo</li>
            <li>Mínimo 4 participantes</li>
            <li>Virtual o presencial según necesidad</li>
            <li>Material de apoyo para cada participante</li>
            <li>Certificado de participación</li>
          </ul>
          <span class="svc-card__cta">Solicitar cotización &rarr;</span>
        </div>

        <div class="card svc-card svc-card--clickable svc-card--featured" data-service="Taller PYME de IA - 3 horas, sin límite de personas - ₡37,500" role="button" tabindex="0">
          <span class="badge badge--cyan">PYMEs</span>
          <h3 class="svc-card__title">Taller PYME de IA</h3>
          <p class="svc-card__subtitle">Virtual o presencial &middot; 3 horas</p>
          <p class="svc-card__price"><span class="price-original">&#8353;50,000</span> <span class="price-launch">&#8353;37,500</span><span class="launch-tag">-25%</span></p>
          <ul class="svc-card__list">
            <li>Taller práctico de 3 horas</li>
            <li>Sin límite de participantes</li>
            <li>Virtual o presencial según necesidad</li>
            <li>Material de apoyo para cada participante</li>
            <li>Certificado de participación</li>
            <li>Enfocado en las necesidades de tu negocio</li>
          </ul>
          <p class="svc-card__save">Precio fijo, invitá a todo tu equipo</p>
          <span class="svc-card__cta">Agendar taller &rarr;</span>
        </div>
      </div>
    </div>
  </section>

  <!-- PAQUETES WEB -->
  <section class="section" id="web">
    <div class="container">
      <div class="ofertas-section__header">
        <h2>&#127760; Paquetes de sitio web</h2>
        <p class="text-muted">Sitios profesionales para tu negocio &mdash; sin cuotas de hosting</p>
      </div>

      <div class="grid grid--3">
        <div class="card svc-card svc-card--clickable" data-service="Presencia Digital (Landing page + dominio) - Desde ₡90,000" role="button" tabindex="0">
          <span class="badge badge--sky">Landing</span>
          <h3 class="svc-card__title">Presencia Digital</h3>
          <p class="svc-card__price"><span class="price-original">&#8353;120,000</span> Desde <span class="price-launch">&#8353;90,000</span><span class="launch-tag">-25%</span></p>
          <ul class="svc-card__list">
            <li>1 página profesional</li>
            <li>Formulario de contacto</li>
            <li>Diseño responsive (celular y computadora)</li>
            <li>SSL y hosting gratis para siempre</li>
            <li>Dominio incluido (1 año)</li>
          </ul>
          <p class="svc-card__save">Entrega en 1 semana</p>
          <span class="svc-card__cta">Cotizar &rarr;</span>
        </div>

        <div class="card svc-card svc-card--clickable svc-card--featured" data-service="Sitio Profesional (3-5 páginas + Blog + SEO) - Desde ₡187,500" role="button" tabindex="0">
          <span class="badge badge--cyan">Más popular</span>
          <h3 class="svc-card__title">Sitio Profesional</h3>
          <p class="svc-card__price"><span class="price-original">&#8353;250,000</span> Desde <span class="price-launch">&#8353;187,500</span><span class="launch-tag">-25%</span></p>
          <ul class="svc-card__list">
            <li>3-5 páginas completas</li>
            <li>Blog integrado</li>
            <li>SEO básico + Google My Business</li>
            <li>Botón de WhatsApp</li>
            <li>Email profesional</li>
            <li>Hosting gratis para siempre</li>
          </ul>
          <p class="svc-card__save">Entrega en 2 semanas</p>
          <span class="svc-card__cta">Cotizar &rarr;</span>
        </div>

        <div class="card svc-card svc-card--clickable" data-service="Tienda Básica (E-commerce + catálogo + pagos) - Desde ₡300,000" role="button" tabindex="0">
          <span class="badge badge--sky">E-commerce</span>
          <h3 class="svc-card__title">Tienda Básica</h3>
          <p class="svc-card__price"><span class="price-original">&#8353;400,000</span> Desde <span class="price-launch">&#8353;300,000</span><span class="launch-tag">-25%</span></p>
          <ul class="svc-card__list">
            <li>Todo lo del Sitio Profesional</li>
            <li>Catálogo de productos</li>
            <li>Carrito de compras</li>
            <li>Pagos SINPE/transferencia</li>
          </ul>
          <p class="svc-card__save">Entrega en 3-4 semanas</p>
          <span class="svc-card__cta">Cotizar &rarr;</span>
        </div>
      </div>
    </div>
  </section>

  <ContactModal />

  <!-- CTA -->
  <section class="section section--dark text-center">
    <div class="container">
      <h2>¿No encontrás lo que buscás?</h2>
      <p style="color: var(--color-gray-300); max-width: 500px; margin: var(--space-md) auto var(--space-xl);">
        Contactanos y armamos un paquete a tu medida. Sin compromisos.
      </p>
      <div style="display: flex; gap: var(--space-md); justify-content: center; flex-wrap: wrap;">
        <a href="https://wa.me/50660931438?text=Hola%20Teknika%20CR%2C%20quiero%20cotizar%20un%20paquete%20personalizado"
           class="btn btn--whatsapp btn--lg"
           target="_blank"
           rel="noopener">
          WhatsApp
        </a>
        <a href="/contacto" class="btn btn--accent btn--lg">
          Formulario
        </a>
      </div>
    </div>
  </section>

</Base>

<style>
  .page-header {
    background: linear-gradient(135deg, var(--color-dark) 0%, var(--color-navy) 100%);
    color: var(--color-white);
    padding: var(--space-3xl) 0 var(--space-2xl);
    text-align: center;
  }

  .page-header h1 {
    color: var(--color-white);
    margin-bottom: var(--space-sm);
  }

  .page-header p {
    color: var(--color-gray-300);
  }

  .ofertas-section__header {
    margin-bottom: var(--space-2xl);
  }

  .ofertas-section__header h2 {
    margin-bottom: var(--space-xs);
  }

  /* Reuse unified card styles */
  .svc-card {
    padding: var(--space-xl);
    display: flex;
    flex-direction: column;
  }

  .svc-card__title {
    font-size: 1.25rem;
    margin-bottom: 0;
    color: var(--color-dark);
  }

  .svc-card__subtitle {
    font-size: 0.8125rem;
    color: var(--color-gray-500);
    margin: 2px 0 var(--space-sm);
    font-weight: 500;
  }

  .svc-card__price {
    font-size: 1.5rem;
    font-weight: 800;
    color: var(--color-royal);
    margin-bottom: var(--space-md);
  }

  .price-original {
    text-decoration: line-through;
    color: var(--color-gray-400);
    font-size: 1rem;
    font-weight: 600;
  }

  .price-launch {
    color: var(--color-cyan);
    font-weight: 800;
  }

  .launch-tag {
    display: inline-block;
    background: var(--color-cyan);
    color: var(--color-white);
    font-size: 0.7rem;
    font-weight: 700;
    padding: 2px 6px;
    border-radius: 4px;
    margin-left: 6px;
    vertical-align: middle;
  }

  .svc-card__list {
    list-style: none;
    padding: 0;
    text-align: left;
    margin-bottom: var(--space-md);
    flex-grow: 1;
  }

  .svc-card__list li {
    padding: 3px 0;
    font-size: 0.9375rem;
    color: var(--color-gray-600);
  }

  .svc-card__list li::before {
    content: '✓ ';
    color: var(--color-cyan);
    font-weight: 700;
  }

  .svc-card__save {
    font-size: 0.8125rem;
    color: var(--color-cyan);
    font-weight: 600;
    margin-bottom: var(--space-sm);
  }

  .svc-card--clickable {
    cursor: pointer;
    transition: all 200ms ease;
    position: relative;
    padding-bottom: calc(var(--space-xl) + 2rem);
  }

  .svc-card--clickable:hover {
    transform: translateY(-4px);
    box-shadow: var(--shadow-lg);
    border-color: var(--color-sky);
  }

  .svc-card--clickable:focus-visible {
    outline: 2px solid var(--color-sky);
    outline-offset: 2px;
  }

  .svc-card__cta {
    position: absolute;
    bottom: var(--space-lg);
    left: var(--space-xl);
    font-size: 0.875rem;
    font-weight: 600;
    color: var(--color-royal);
    transition: all var(--transition);
  }

  .svc-card--clickable:hover .svc-card__cta {
    color: var(--color-sky);
    transform: translateX(4px);
  }

  .svc-card--featured {
    border: 2px solid var(--color-cyan);
  }

  .svc-card--featured:hover {
    border-color: var(--color-cyan);
    box-shadow: 0 10px 30px rgba(68, 207, 203, 0.2);
  }

  @media (max-width: 600px) {
    .grid--3 {
      grid-template-columns: 1fr;
    }
  }
</style>
