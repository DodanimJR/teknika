---
import Base from '../layouts/Base.astro';
import ContactModal from '../components/ContactModal.astro';
import PreciosWeb from '../components/PreciosWeb.astro';
import PreciosIA from '../components/PreciosIA.astro';
---

<Base
  title="Paquetes y precios"
  description="Precios de Teknika CR: asesoría, coaching y capacitación en inteligencia artificial, desarrollo web para PYMEs y soporte técnico en Costa Rica."
  canonical="https://teknika.co.cr/ofertas"
>

  <section class="page-header">
    <div class="container">
      <h1>Paquetes y precios</h1>
      <p>Todos nuestros precios en un solo lugar, en colones y con IVA incluido.</p>
    </div>
  </section>

  <!-- PAQUETES IA (precios desde src/data/precios-ia.ts) -->
  <section class="section" id="ia">
    <div class="container">
      <div class="ofertas-section__header">
        <h2>Asesoría, coaching y capacitación en IA</h2>
        <p class="text-muted">Nuestro servicio principal: aprendé a usar IA en tu trabajo o capacitá a tu equipo</p>
      </div>
      <PreciosIA />
    </div>
  </section>

  <!-- PAQUETES WEB -->
  <section class="section section--alt" id="web">
    <div class="container">
      <div class="ofertas-section__header">
        <h2>&#127760; Paquetes de sitio web</h2>
        <p class="text-muted">Sitios profesionales para tu negocio &mdash; sin cuotas de hosting</p>
      </div>

      <PreciosWeb />
    </div>
  </section>

  <!-- PAQUETES SOPORTE -->
  <section class="section" id="soporte">
    <div class="container">
      <div class="ofertas-section__header">
        <h2>&#128187; Paquetes de soporte técnico</h2>
        <p class="text-muted">Combiná diagnóstico, formateo y configuración con descuento</p>
      </div>

      <div class="grid grid--3">
        <div class="card svc-card svc-card--clickable" data-service="Paquete Básico (Diagnóstico + Limpieza) - ₡18,000" role="button" tabindex="0">
          <span class="badge badge--sky">Básico</span>
          <h3 class="svc-card__title">Paquete Básico</h3>
          <p class="svc-card__price">&#8353;18,000</p>
          <ul class="svc-card__list">
            <li>Diagnóstico completo</li>
            <li>Limpieza interna + pasta térmica</li>
          </ul>
          <p class="svc-card__save">Ahorro ~15% vs individual</p>
          <span class="svc-card__cta">Pedir paquete &rarr;</span>
        </div>

        <div class="card svc-card svc-card--clickable svc-card--featured" data-service="Paquete Completo (Formateo + Backup + Office + Antivirus + Limpieza) - ₡30,000" role="button" tabindex="0">
          <span class="badge badge--cyan">Más vendido</span>
          <h3 class="svc-card__title">Paquete Completo</h3>
          <p class="svc-card__price">&#8353;30,000</p>
          <ul class="svc-card__list">
            <li>Formateo + instalación de Windows o Linux</li>
            <li>Backup de todos tus archivos</li>
            <li>Suite Office instalada</li>
            <li>Antivirus configurado</li>
            <li>Limpieza interna + pasta térmica</li>
            <li>Drivers y actualizaciones</li>
          </ul>
          <p class="svc-card__save">Ahorro ~20% &middot; Tu equipo como nuevo</p>
          <span class="svc-card__cta">Pedir paquete &rarr;</span>
        </div>

        <div class="card svc-card svc-card--clickable" data-service="Paquete Nuevo Equipo (Asesoría + Configuración) - ₡20,000" role="button" tabindex="0">
          <span class="badge badge--sky">Equipo nuevo</span>
          <h3 class="svc-card__title">Paquete Nuevo Equipo</h3>
          <p class="svc-card__price">&#8353;20,000</p>
          <ul class="svc-card__list">
            <li>Asesoría de compra personalizada</li>
            <li>Configuración inicial completa</li>
            <li>Instalación de programas esenciales</li>
          </ul>
          <p class="svc-card__save">Ahorro ~25% vs individual</p>
          <span class="svc-card__cta">Pedir paquete &rarr;</span>
        </div>
      </div>
    </div>
  </section>


  <ContactModal />

  <!-- CTA -->
  <section class="section section--dark text-center">
    <div class="container">
      <h2>¿No encontrás lo que buscás?</h2>
      <p style="color: var(--color-gray-300); max-width: 500px; margin: var(--space-md) auto var(--space-xl);">
        Contactanos y armamos un paquete a tu medida. Sin compromisos.
      </p>
      <div style="display: flex; gap: var(--space-md); justify-content: center; flex-wrap: wrap;">
        <a href="https://wa.me/50671951856?text=Hola%20Teknika%20CR%2C%20quiero%20cotizar%20un%20paquete%20personalizado"
           class="btn btn--whatsapp btn--lg"
           target="_blank"
           rel="noopener">
          WhatsApp
        </a>
        <a href="/contacto" class="btn btn--outline-light btn--lg">
          Formulario
        </a>
      </div>
    </div>
  </section>

</Base>

<style>
  .ofertas-section__header {
    margin-bottom: var(--space-2xl);
  }

  .ofertas-section__header h2 {
    margin-bottom: var(--space-xs);
  }

  /* Reuse unified card styles */
  .svc-card {
    padding: var(--space-xl);
    display: flex;
    flex-direction: column;
  }

  .svc-card__title {
    font-size: 1.25rem;
    margin-bottom: 0;
    color: var(--color-dark);
  }

  .svc-card__subtitle {
    font-size: 0.8125rem;
    color: var(--color-gray-500);
    margin: 2px 0 var(--space-sm);
    font-weight: 500;
  }

  .svc-card__price {
    font-size: 1.5rem;
    font-weight: 800;
    color: var(--color-royal);
    margin-bottom: var(--space-md);
  }

  .svc-card__list {
    list-style: none;
    padding: 0;
    text-align: left;
    margin-bottom: var(--space-md);
    flex-grow: 1;
  }

  .svc-card__list li {
    padding: 3px 0;
    font-size: 0.9375rem;
    color: var(--color-gray-600);
  }

  .svc-card__list li::before {
    content: '✓ ';
    color: var(--color-cyan-text);
    font-weight: 700;
  }

  .svc-card__save {
    font-size: 0.8125rem;
    color: var(--color-cyan-text);
    font-weight: 600;
    margin-bottom: var(--space-sm);
  }

  .svc-card--clickable {
    cursor: pointer;
    transition: transform 200ms ease, box-shadow 200ms ease, border-color 200ms ease;
    position: relative;
    padding-bottom: calc(var(--space-xl) + 2rem);
  }

  .svc-card--clickable:hover {
    transform: translateY(-4px);
    box-shadow: var(--shadow-lg);
    border-color: var(--color-sky);
  }

  .svc-card--clickable:focus-visible {
    outline: 2px solid var(--color-sky);
    outline-offset: 2px;
  }

  .svc-card__cta {
    position: absolute;
    bottom: var(--space-lg);
    left: var(--space-xl);
    font-size: 0.875rem;
    font-weight: 600;
    color: var(--color-royal);
    transition: color var(--transition), transform var(--transition);
  }

  .svc-card--clickable:hover .svc-card__cta {
    color: var(--color-sky);
    transform: translateX(4px);
  }

  .svc-card--featured {
    border: 2px solid var(--color-cyan);
  }

  .svc-card--featured:hover {
    border-color: var(--color-cyan);
    box-shadow: 0 10px 30px rgba(68, 207, 203, 0.2);
  }

  @media (max-width: 600px) {
    .grid--3 {
      grid-template-columns: 1fr;
    }
  }
</style>
