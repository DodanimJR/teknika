---
import Base from '../../layouts/Base.astro';
import { getCollection } from 'astro:content';

const posts = (await getCollection('blog')).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf()
);
---

<Base
  title="Blog"
  description="Blog de Teknika CR: artículos sobre inteligencia artificial, desarrollo web, guías de compra y tips de tecnología para organizaciones y PYMEs en Costa Rica."
  canonical="https://teknika.co.cr/blog"
>

  <section class="page-header">
    <div class="container">
      <h1>Blog</h1>
      <p>Artículos sobre IA, tecnología y productividad para tu negocio</p>
    </div>
  </section>

  <section class="section">
    <div class="container">
      {posts.length > 0 ? (
        <div class="blog-grid">
          {posts.map((post) => (
            <article class="blog-card card">
              <div class="blog-card__tags">
                {post.data.tags.slice(0, 3).map((tag: string) => (
                  <span class="badge badge--sky">{tag}</span>
                ))}
              </div>
              <h2 class="blog-card__title">
                <a href={`/blog/${post.slug}/`}>{post.data.title}</a>
              </h2>
              <p class="blog-card__excerpt">{post.data.description}</p>
              <div class="blog-card__meta">
                <span class="blog-card__date">
                  {post.data.date.toLocaleDateString('es-CR', {
                    year: 'numeric',
                    month: 'long',
                    day: 'numeric',
                  })}
                </span>
                <span class="blog-card__author">{post.data.author}</span>
              </div>
              <a href={`/blog/${post.slug}/`} class="blog-card__cta">Leer artículo &rarr;</a>
            </article>
          ))}
        </div>
      ) : (
        <div class="blog-coming-soon">
          <h2>Contenido en camino</h2>
          <p class="text-muted">Estamos preparando artículos sobre IA y tecnología.</p>
        </div>
      )}

      <div class="text-center" style="margin-top: var(--space-2xl);">
        <p class="text-muted">
          Seguinos en redes sociales para más contenido tech diario.
        </p>
        <div style="display: flex; gap: var(--space-md); justify-content: center; margin-top: var(--space-lg); flex-wrap: wrap;">
          <a href="https://www.instagram.com/teknikacr/" target="_blank" rel="noopener" class="btn btn--outline-dark btn--sm">Instagram</a>
          <a href="https://www.tiktok.com/@teknikacr" target="_blank" rel="noopener" class="btn btn--outline-dark btn--sm">TikTok</a>
          <a href="https://www.facebook.com/profile.php?id=61591716943373" target="_blank" rel="noopener" class="btn btn--outline-dark btn--sm">Facebook</a>
        </div>
      </div>
    </div>
  </section>

</Base>

<style>
  .blog-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(320px, 1fr));
    gap: var(--space-xl);
  }

  .blog-card {
    padding: var(--space-xl);
    display: flex;
    flex-direction: column;
  }

  .blog-card__tags {
    display: flex;
    gap: var(--space-xs);
    flex-wrap: wrap;
    margin-bottom: var(--space-sm);
  }

  .blog-card__title {
    font-size: 1.25rem;
    margin-bottom: var(--space-sm);
    line-height: 1.3;
  }

  .blog-card__title a {
    color: var(--color-dark);
    text-decoration: none;
    transition: color 0.2s ease;
  }

  .blog-card__title a:hover {
    color: var(--color-primary);
  }

  .blog-card__excerpt {
    color: var(--color-text-muted);
    font-size: 0.9375rem;
    line-height: 1.6;
    margin-bottom: var(--space-md);
    flex-grow: 1;
  }

  .blog-card__meta {
    display: flex;
    justify-content: space-between;
    font-size: 0.8125rem;
    color: var(--color-gray-500);
    margin-bottom: var(--space-sm);
  }

  .blog-card__cta {
    font-size: 0.875rem;
    font-weight: 600;
    color: var(--color-royal);
    text-decoration: none;
    transition: color 0.2s ease;
  }

  .blog-card__cta:hover {
    color: var(--color-sky);
  }

  .blog-coming-soon {
    text-align: center;
    padding: var(--space-3xl) var(--space-xl);
  }
</style>
