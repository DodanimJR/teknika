---
import Base from '../../layouts/Base.astro';

// Placeholder - cuando agregués posts, los importás acá
const posts = [
  {
    title: 'Próximamente: contenido tech para vos',
    description: 'Estamos preparando artículos, guías y tips para que le saqués el máximo provecho a tu equipo.',
    date: '2026-07-17',
    slug: '#',
  },
];
---

<Base
  title="Blog"
  description="Blog de Teknika CR: tips de mantenimiento, guías de compra y tutoriales de tecnología para Costa Rica."
  canonical="https://teknika.co.cr/blog"
>

  <section class="page-header">
    <div class="container">
      <h1>Blog</h1>
      <p>Tips, guías y contenido tech para que cuides tu equipo</p>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="blog-grid">
        {posts.map((post) => (
          <article class="blog-card card">
            <span class="badge badge--sky">{new Date(post.date).toLocaleDateString('es-CR', { year: 'numeric', month: 'long', day: 'numeric' })}</span>
            <h2 class="blog-card__title">
              <a href={`/blog/${post.slug}`}>{post.title}</a>
            </h2>
            <p class="blog-card__excerpt">{post.description}</p>
          </article>
        ))}
      </div>

      <div class="text-center" style="margin-top: var(--space-2xl);">
        <p class="text-muted">
          Seguinos en redes sociales para más contenido tech.
        </p>
      </div>
    </div>
  </section>

</Base>

<style>
  .page-header {
    background: linear-gradient(135deg, var(--color-dark) 0%, var(--color-navy) 100%);
    color: var(--color-white);
    padding: var(--space-3xl) 0 var(--space-2xl);
    text-align: center;
  }

  .page-header h1 {
    color: var(--color-white);
    margin-bottom: var(--space-sm);
  }

  .page-header p {
    color: var(--color-gray-300);
  }

  .blog-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(320px, 1fr));
    gap: var(--space-xl);
  }

  .blog-card {
    padding: var(--space-xl);
  }

  .blog-card__title {
    font-size: 1.25rem;
    margin: var(--space-md) 0 var(--space-sm);
  }

  .blog-card__title a {
    color: var(--color-dark);
    text-decoration: none;
  }

  .blog-card__title a:hover {
    color: var(--color-primary);
  }

  .blog-card__excerpt {
    color: var(--color-text-muted);
    font-size: 0.9375rem;
    margin: 0;
  }
</style>
