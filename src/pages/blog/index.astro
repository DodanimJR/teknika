---
import Base from '../../layouts/Base.astro';
---

<Base
  title="Blog"
  description="Blog de Teknika CR: tips de mantenimiento, guías de compra y tutoriales de tecnología para Costa Rica."
  canonical="https://teknika.co.cr/blog"
>

  <section class="page-header">
    <div class="container">
      <h1>Blog</h1>
      <p>Tips, guías y contenido tech para que cuides tu equipo</p>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="blog-coming-soon">
        <div class="blog-coming-soon__icon" aria-hidden="true">
          <svg width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="var(--color-cyan)" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M12 20h9" /><path d="M16.5 3.5a2.121 2.121 0 0 1 3 3L7 19l-4 1 1-4L16.5 3.5z" />
          </svg>
        </div>
        <h2>Contenido en camino</h2>
        <p class="text-muted">
          Estamos preparando artículos, guías y tips para que le saqués
          el máximo provecho a tu equipo. Mientras tanto, seguinos en redes
          sociales para contenido tech diario.
        </p>
        <div style="display: flex; gap: var(--space-md); justify-content: center; margin-top: var(--space-lg); flex-wrap: wrap;">
          <a href="https://www.instagram.com/teknikacr/" target="_blank" rel="noopener" class="btn btn--outline btn--sm">Instagram</a>
          <a href="https://www.tiktok.com/@teknikacr" target="_blank" rel="noopener" class="btn btn--outline btn--sm">TikTok</a>
          <a href="https://www.facebook.com/profile.php?id=61591716943373" target="_blank" rel="noopener" class="btn btn--outline btn--sm">Facebook</a>
        </div>
      </div>
    </div>
  </section>

</Base>

<style>
  .blog-coming-soon {
    text-align: center;
    padding: var(--space-3xl) var(--space-xl);
    max-width: 500px;
    margin: 0 auto;
  }

  .blog-coming-soon__icon {
    margin-bottom: var(--space-lg);
  }

  .blog-coming-soon h2 {
    font-size: 1.5rem;
    margin-bottom: var(--space-md);
  }

  .blog-coming-soon p {
    font-size: 0.9375rem;
    line-height: 1.7;
  }
</style>
