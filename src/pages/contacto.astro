---
import Base from '../layouts/Base.astro';
import { AGENDA_URL, WHATSAPP_URL } from '../data/contacto';
---

<Base
  title="Contacto"
  description="Contactá a Teknika CR para asesoría, coaching o capacitación en inteligencia artificial, desarrollo web o soporte técnico en Costa Rica. WhatsApp, email o formulario."
  canonical="https://teknika.co.cr/contacto"
>

  <section class="page-header">
    <div class="container">
      <h1>Contacto</h1>
      <p>Contanos qué querés lograr con IA. Te respondemos en menos de 2 horas hábiles.</p>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="contact-grid">

        <div class="contact-info">
          <h2>Hablemos</h2>
          <p>
            Agendá una llamada de 15 minutos para conversar sobre IA en tu trabajo o tu equipo.
            También podés escribirnos por WhatsApp, por correo o con el formulario.
          </p>

          <div class="contact-channels">
            <a href={AGENDA_URL}
               class="btn btn--primary btn--lg"
               target="_blank"
               rel="noopener"
               style="width: 100%; justify-content: center; margin-bottom: var(--space-sm);">
              Agendar una llamada
            </a>
            <a data-service="Consulta general" href={WHATSAPP_URL}
               class="btn btn--whatsapp btn--lg"
               target="_blank"
               rel="noopener"
               style="width: 100%; justify-content: center;">
              Escribir por WhatsApp
            </a>

            <div class="contact-item">
              <span class="contact-item__icon">&#9993;</span>
              <div>
                <strong>Email</strong>
                <a href="mailto:info@teknika.co.cr">info@teknika.co.cr</a>
              </div>
            </div>

            <div class="contact-item">
              <span class="contact-item__icon">&#128205;</span>
              <div>
                <strong>Zona de cobertura</strong>
                <p>Virtual en todo Costa Rica &middot; Presencial en el GAM</p>
              </div>
            </div>

            <div class="contact-item">
              <span class="contact-item__icon">&#128336;</span>
              <div>
                <strong>Horario</strong>
                <p>Lunes a Viernes: 9am - 5pm<br />Sábado y Domingo: Cerrado</p>
              </div>
            </div>
          </div>
        </div>

        <div class="contact-form-wrap">
          <h2>Formulario de contacto</h2>
          <form action="https://formspree.io/f/mqerpoor" method="POST" class="contact-form" id="contact-form">
            <div class="form-group">
              <label for="name">Nombre</label>
              <input type="text" id="name" name="name" required placeholder="Tu nombre" autocomplete="name" />
            </div>

            <div class="form-group">
              <label for="email">Email</label>
              <input type="email" id="email" name="email" required placeholder="tu@email.com" autocomplete="email" />
            </div>

            <div class="form-group">
              <label for="phone">Teléfono (opcional)</label>
              <input type="tel" id="phone" name="phone" placeholder="+506 0000-0000" autocomplete="tel" />
            </div>

            <div class="form-group">
              <label for="service">Servicio que necesitás</label>
              <select id="service" name="service">
                <option value="">Seleccionar...</option>
                <option value="ia-personal">Asesoría o coaching en IA (para mí)</option>
                <option value="ia-equipo">Capacitación en IA para mi equipo</option>
                <option value="desarrollo-web">Desarrollo web</option>
                <option value="soporte">Soporte técnico</option>
                <option value="otro">Otro</option>
              </select>
            </div>

            <div class="form-group">
              <label for="message">Mensaje</label>
              <textarea id="message" name="message" rows="4" required
                        placeholder="Describí tu problema o consulta..."></textarea>
            </div>

            <button type="submit" class="btn btn--primary btn--lg" style="width: 100%; justify-content: center;">
              Enviar mensaje
            </button>
          </form>
        </div>

      </div>
    </div>
  </section>

</Base>

<style>

  .contact-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--space-3xl);
    align-items: start;
  }

  .contact-channels {
    display: flex;
    flex-direction: column;
    gap: var(--space-lg);
    margin-top: var(--space-xl);
  }

  .contact-item {
    display: flex;
    gap: var(--space-md);
    align-items: flex-start;
  }

  .contact-item__icon {
    font-size: 1.5rem;
    flex-shrink: 0;
  }

  .contact-item p {
    margin: 0;
    color: var(--color-text-muted);
    font-size: 0.9375rem;
  }

  .contact-item a {
    color: var(--color-primary);
  }

  /* Form */
  .contact-form {
    display: flex;
    flex-direction: column;
    gap: var(--space-lg);
  }

  .form-group {
    display: flex;
    flex-direction: column;
    gap: var(--space-xs);
  }

  .form-group label {
    font-weight: 600;
    font-size: 0.9375rem;
    color: var(--color-gray-700);
  }

  .form-group input,
  .form-group select,
  .form-group textarea {
    padding: 0.75rem 1rem;
    border: 1px solid var(--color-gray-200);
    border-radius: var(--radius-md);
    font-family: var(--font-sans);
    font-size: 1rem;
    color: var(--color-dark);
    background: var(--color-white);
    transition: border-color var(--transition);
  }

  .form-group input:focus-visible,
  .form-group select:focus-visible,
  .form-group textarea:focus-visible {
    outline: 2px solid var(--color-sky);
    outline-offset: 2px;
    border-color: var(--color-sky);
    box-shadow: 0 0 0 3px rgba(78, 165, 217, 0.15);
  }

  .form-group textarea {
    resize: vertical;
  }

  @media (max-width: 768px) {
    .contact-grid {
      grid-template-columns: 1fr;
      gap: var(--space-2xl);
    }
  }
</style>

<script>
  // Prellenar desde ?servicio= y registrar el lead en HubSpot (sin bloquear el envío a Formspree)
  const form = document.getElementById('contact-form') as HTMLFormElement | null;
  if (form) {
    const svc = new URLSearchParams(location.search).get('servicio');
    if (svc) {
      const select = form.querySelector('select[name="service"]') as HTMLSelectElement | null;
      const msg = form.querySelector('textarea[name="message"]') as HTMLTextAreaElement | null;
      const t = svc.toLowerCase();
      if (select) {
        select.value = /taller|programa|equipo|organizaci/.test(t) ? 'ia-equipo'
          : /ia|coaching|sesi/.test(t) ? 'ia-personal'
          : /web|sitio|tienda|presencia/.test(t) ? 'desarrollo-web'
          : /soporte|formateo|diagn/.test(t) ? 'soporte' : 'otro';
      }
      if (msg && !msg.value) msg.value = `Me interesa: ${svc}\n`;
    }
    form.addEventListener('submit', () => {
      const d = new FormData(form);
      const select = form.querySelector('select[name="service"]') as HTMLSelectElement | null;
      const payload = JSON.stringify({
        nombre: d.get('name'),
        email: d.get('email'),
        telefono: d.get('phone'),
        servicio: select?.selectedOptions[0]?.textContent || '',
        mensaje: d.get('message'),
        origen: 'Formulario de contacto',
        pagina: location.pathname,
      });
      try {
        navigator.sendBeacon('/api/lead', new Blob([payload], { type: 'application/json' }));
      } catch {}
    });
  }
</script>
